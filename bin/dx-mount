#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") [DIR] [--container NAME] [--print-env] [--destroy] [--print-destroy-plan]
       $(basename "$0") [DIR] [--container NAME] --migrate-manifests [--apply]
       $(basename "$0") --audit-manifests

Create or attach an isolated side container for DIR. The repository root is
mounted at DX_GIT_MOUNT_TARGET and plain dx-host is never used.

  --container NAME       Use an explicit safe, non-default container name.
  --print-env            Print the immutable resolved DX_* plan without creating or starting anything.
  --destroy              Destroy only manifest-authorized private resources.
  --print-destroy-plan   Preview exactly what --destroy would remove.
  --migrate-manifests    Report legacy manifest migration eligibility.
  --apply                With --migrate-manifests, atomically convert to v2.
  --audit-manifests      Report local manifest format and completeness.
EOF
}

fail() { local message="$1" status="${2:-1}"; echo "Error: $message" >&2; exit "$status"; }
origin_explicit() {
    local origin_var origin
    origin_var="DXE_CONFIG_ORIGIN_$1"
    origin=${!origin_var:-default}
    case "$origin" in environment|profile:*) return 0 ;; *) return 1 ;; esac
}
set_plan() { dx_config_set_resolved "$1" "$2" "$3"; }
plan_field_value() {
    case "$1" in
        CONTAINER_NAME) printf '%s' "$DX_CONTAINER_NAME" ;;
        GIT_MOUNT_SOURCE) printf '%s' "$DX_GIT_MOUNT_SOURCE" ;;
        GIT_MOUNT_TARGET) printf '%s' "$DX_GIT_MOUNT_TARGET" ;;
        IMAGE) printf '%s' "$DX_IMAGE" ;;
        NIX_VOLUME) printf '%s' "$DX_NIX_VOLUME" ;;
        PERSIST_VOLUME) printf '%s' "$DX_PERSIST_VOLUME" ;;
        BOOTSTRAP_VOLUME) printf '%s' "$DX_BOOTSTRAP_VOLUME" ;;
        SSH_KEY) printf '%s' "$DX_SSH_KEY" ;;
        SSH_KEY_PUB) printf '%s' "$DX_SSH_KEY_PUB" ;;
        SSH_PORT) printf '%s' "$DX_SSH_PORT" ;;
    esac
}
apply_recorded_field() {
    local field="$1" var value
    var="DX_RECORDED_$1"
    value=${!var:-}
    [ -n "$value" ] || return 0
    case "$field" in
        CONTAINER_NAME) set_plan DX_CONTAINER_NAME "$value" manifest ;;
        GIT_MOUNT_SOURCE) set_plan DX_GIT_MOUNT_SOURCE "$value" manifest ;;
        GIT_MOUNT_TARGET) set_plan DX_GIT_MOUNT_TARGET "$value" manifest ;;
        IMAGE) set_plan DX_IMAGE "$value" manifest ;;
        NIX_VOLUME) set_plan DX_NIX_VOLUME "$value" manifest ;;
        PERSIST_VOLUME) set_plan DX_PERSIST_VOLUME "$value" manifest ;;
        BOOTSTRAP_VOLUME) set_plan DX_BOOTSTRAP_VOLUME "$value" manifest ;;
        SSH_KEY) set_plan DX_SSH_KEY "$value" manifest ;;
        SSH_KEY_PUB) set_plan DX_SSH_KEY_PUB "$value" manifest ;;
        SSH_PORT) set_plan DX_SSH_PORT "$value" manifest ;;
    esac
}
refuse_default_destroy() {
    [ "$2" != "$3" ] || { echo "Error: refusing to destroy default dx-host resource ($1=$2)." >&2; return 1; }
}
print_destroy_plan() {
    cat <<EOF
Destroy plan for $DX_CONTAINER_NAME (resolution: $resolution_source):
  container:          $DX_CONTAINER_NAME
  image:               $DX_IMAGE
  nix volume:          $DX_NIX_VOLUME
  persist volume:      $DX_PERSIST_VOLUME
  bootstrap volume:    $DX_BOOTSTRAP_VOLUME
  ssh key:             $DX_SSH_KEY
  ssh key (public):    $DX_SSH_KEY_PUB
  mount target:        $DX_GIT_MOUNT_TARGET
  ssh port:            $DX_SSH_PORT
  identity marker:     $identity_file
Nothing has been deleted or written.
EOF
}
print_env() {
    local name
    for name in DX_CONTAINER_NAME DX_IMAGE DX_GIT_MOUNT_SOURCE DX_GIT_MOUNT_TARGET DX_GUEST_WORKDIR DX_NIX_VOLUME DX_PERSIST_VOLUME DX_BOOTSTRAP_VOLUME DX_SSH_PORT DX_SSH_KEY DX_SSH_KEY_PUB DX_CONTAINER_MEMORY DX_CONTAINER_CPUS; do
        printf 'export %s=%q\n' "$name" "${!name}"
    done
}
release_lock() { [ -z "${mount_lock:-}" ] || dx_lock_release "$mount_lock" || true; mount_lock=""; }
trap release_lock EXIT HUP INT TERM

dir=""; container_override=""; print_environment=false; destroy=false
print_plan=false; audit=false; migrate=false; apply=false
while [ "$#" -gt 0 ]; do
    case "$1" in
        --container) [ "$#" -ge 2 ] || fail "--container requires a name." 2; container_override=$2; shift 2 ;;
        --container=*) container_override=${1#*=}; shift ;;
        --print-env) print_environment=true; shift ;;
        --destroy) destroy=true; shift ;;
        --print-destroy-plan) print_plan=true; shift ;;
        --audit-manifests) audit=true; shift ;;
        --migrate-manifests) migrate=true; shift ;;
        --apply) apply=true; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) fail "unknown option: $1" 2 ;;
        *) [ -z "$dir" ] || fail "only one DIR argument is supported." 2; dir=$1; shift ;;
    esac
done
[ "$#" -eq 0 ] || fail "unexpected arguments: $*" 2
mode_count=0
for enabled in "$print_environment" "$destroy" "$print_plan" "$audit" "$migrate"; do [ "$enabled" = false ] || mode_count=$((mode_count + 1)); done
[ "$mode_count" -le 1 ] || fail "print, destroy, audit, and migration modes are mutually exclusive." 2
[ "$apply" = false ] || [ "$migrate" = true ] || fail "--apply requires --migrate-manifests." 2

if [ "$audit" = true ]; then
    found=false; audit_dirs=" $DX_MOUNT_IDENTITY_DIR
"; profiles_dir="${DX_PROFILES_DIR:-$DX_PROJECT_ROOT/tests/profiles}"
    if [ -d "$profiles_dir" ]; then
        for profile_file in "$profiles_dir"/*.env; do
            [ -f "$profile_file" ] || continue
            profile_identity="$(dx_parse_config_file "$profile_file" >/dev/null && printf '%s' "${DXE_PARSED_DX_MOUNT_IDENTITY_DIR:-}")"
            [ -z "$profile_identity" ] || case "$audit_dirs" in *" $profile_identity
"*) ;; *) audit_dirs="$audit_dirs $profile_identity
" ;; esac
        done
    fi
    while IFS= read -r audit_dir; do
        audit_dir=${audit_dir# }; [ -n "$audit_dir" ] || continue
        if [ -d "$audit_dir" ]; then
        for identity_file in "$audit_dir"/*.env; do
            [ -f "$identity_file" ] || continue; found=true
            if dx_mount_manifest_secure_read "$identity_file"; then
                eligible=false; [ "$DX_MOUNT_MANIFEST_FORMAT" != 2 ] && [ "$DX_MOUNT_MANIFEST_COMPLETE" = true ] && eligible=true
                printf '%s format=v%s complete=%s migration-eligible=%s\n' "$identity_file" "$DX_MOUNT_MANIFEST_FORMAT" "$DX_MOUNT_MANIFEST_COMPLETE" "$eligible"
            else printf '%s malformed\n' "$identity_file"; fi
        done
        fi
    done <<EOF
$audit_dirs
EOF
    [ "$found" = true ] || echo "No mount manifests found."
    exit 0
fi

[ -z "$container_override" ] || { dx_require_container_safe_name "$container_override"; dx_require_non_reserved_container_name "$container_override"; }
dir=${dir:-$PWD}
if [ ! -d "$dir" ]; then
    [ -n "$container_override" ] && { [ "$destroy" = true ] || [ "$print_plan" = true ]; } || fail "DIR is not a directory: $dir"
    resolved_dir=""; mount_source=""
else
    resolved_dir="$(cd "$dir" && pwd -P)"
    if git_top="$(git -C "$resolved_dir" rev-parse --show-toplevel 2>/dev/null)"; then mount_source="$(cd "$git_top" && pwd -P)"; else mount_source=$resolved_dir; fi
fi
if [ -n "$container_override" ]; then container_name=$container_override; else container_name="$(dx_derived_name dx-mount- "$mount_source" "$mount_source")"; fi
safe_name="$(dx_slugify "$container_name" mount 48)"
identity_file="$DX_MOUNT_IDENTITY_DIR/$container_name.env"
guest_workdir=$DX_GIT_MOUNT_TARGET
if [ -n "$resolved_dir" ] && [ "$resolved_dir" != "$mount_source" ]; then guest_workdir="$DX_GIT_MOUNT_TARGET/${resolved_dir#"$mount_source"/}"; fi
if [ -n "$container_override" ]; then set_plan DX_CONTAINER_NAME "$container_name" flag; else set_plan DX_CONTAINER_NAME "$container_name" mount-derived; fi
set_plan DX_GIT_MOUNT_SOURCE "$mount_source" mount-plan
set_plan DX_GUEST_WORKDIR "$guest_workdir" mount-plan
origin_explicit DX_NIX_VOLUME || set_plan DX_NIX_VOLUME "$container_name-nix" mount-derived
origin_explicit DX_PERSIST_VOLUME || set_plan DX_PERSIST_VOLUME "$container_name-persist" mount-derived
origin_explicit DX_BOOTSTRAP_VOLUME || set_plan DX_BOOTSTRAP_VOLUME "$container_name-bootstrap" mount-derived
origin_explicit DX_SSH_KEY || set_plan DX_SSH_KEY "$DX_PROJECT_ROOT/${safe_name}_key" mount-derived
origin_explicit DX_SSH_KEY_PUB || set_plan DX_SSH_KEY_PUB "$DX_PROJECT_ROOT/${safe_name}_key.pub" mount-derived
origin_explicit DX_SSH_PORT || set_plan DX_SSH_PORT "$(dx_derived_port "$container_name")" mount-derived
origin_explicit DX_CONTAINER_MEMORY || set_plan DX_CONTAINER_MEMORY 6G mount-derived
origin_explicit DX_CONTAINER_CPUS || set_plan DX_CONTAINER_CPUS 2 mount-derived
[ "$print_environment" = false ] || { print_env; exit 0; }

dx_mount_prepare_identity_dir "$DX_MOUNT_IDENTITY_DIR"
dx_mount_prepare_identity_dir "$DX_MOUNT_IDENTITY_DIR/.locks"
mount_lock="$DX_MOUNT_IDENTITY_DIR/.locks/$container_name.lock"
dx_lock_acquire "$mount_lock" "$DX_TUNNEL_LOCK_TIMEOUT"
marker_present=false; manifest_present=false
if [ -e "$identity_file" ]; then
    dx_mount_manifest_secure_read "$identity_file"; marker_present=true
    [ -n "${DX_RECORDED_CONTAINER_NAME:-}" ] && manifest_present=true
fi

if [ "$migrate" = true ]; then
    [ "$marker_present" = true ] || fail "no mount manifest found at $identity_file"
    if [ "$DX_MOUNT_MANIFEST_FORMAT" = 2 ]; then echo "$identity_file is already format v2."; exit 0; fi
    [ "$DX_MOUNT_MANIFEST_COMPLETE" = true ] || fail "legacy manifest is incomplete; destroy and recreate $container_name instead."
    for field in $DX_MOUNT_MANIFEST_FIELDS; do recorded="DX_RECORDED_$field"; [ "${!recorded}" = "$(plan_field_value "$field")" ] || fail "legacy manifest does not match the resolved plan; destroy and recreate $container_name instead."; done
    [ "$apply" = true ] || { echo "$identity_file format=v$DX_MOUNT_MANIFEST_FORMAT complete=true migration-eligible=true"; exit 0; }
    dx_mount_manifest_replace_v2 "$identity_file"; echo "Migrated $identity_file to format v2."; exit 0
fi

if [ "$destroy" = true ] || [ "$print_plan" = true ]; then
    [ -z "$container_override" ] || [ "$marker_present" = true ] || fail "no mount identity marker found for container $container_name; refusing destroy-only resolution."
    if [ "$manifest_present" = true ]; then
        [ "$DX_RECORDED_CONTAINER_NAME" = "$container_name" ] || fail "mount identity marker records a different container name."
        for field in $DX_MOUNT_MANIFEST_FIELDS; do [ "$field" = CONTAINER_NAME ] || apply_recorded_field "$field"; done
        resolution_source=manifest
    elif [ -n "$container_override" ]; then
        set_plan DX_NIX_VOLUME "$container_name-nix" legacy; set_plan DX_PERSIST_VOLUME "$container_name-persist" legacy
        set_plan DX_BOOTSTRAP_VOLUME "$container_name-bootstrap" legacy; set_plan DX_SSH_KEY "$DX_PROJECT_ROOT/${safe_name}_key" legacy
        set_plan DX_SSH_KEY_PUB "$DX_PROJECT_ROOT/${safe_name}_key.pub" legacy; resolution_source=legacy
    elif [ "$marker_present" = true ]; then resolution_source=legacy; else resolution_source="name-derived"; fi
    refuse_default_destroy DX_NIX_VOLUME "$DX_NIX_VOLUME" dx-nix
    refuse_default_destroy DX_PERSIST_VOLUME "$DX_PERSIST_VOLUME" dx-persist
    refuse_default_destroy DX_BOOTSTRAP_VOLUME "$DX_BOOTSTRAP_VOLUME" dx-bootstrap
    refuse_default_destroy DX_SSH_KEY "$DX_SSH_KEY" "$DX_PROJECT_ROOT/dx_key"
    refuse_default_destroy DX_SSH_KEY_PUB "$DX_SSH_KEY_PUB" "$DX_PROJECT_ROOT/dx_key.pub"
    [ "$print_plan" = false ] || { print_destroy_plan; exit 0; }
    dx_require_container_cli
    echo "Destroying mount side container $container_name and private state..."
    "$SCRIPT_DIR/dx-destroy-container"; "$SCRIPT_DIR/dx-destroy-volumes" --force; "$SCRIPT_DIR/dx-destroy-keys"; rm -f "$identity_file"; exit 0
fi

dx_require_container_cli
if [ -n "$container_override" ] && container_exists "$container_name" && [ "$marker_present" = false ]; then fail "container $container_name exists without a mount identity marker; refusing attach."; fi
if [ "$manifest_present" = true ]; then
    [ "$DX_RECORDED_CONTAINER_NAME" = "$container_name" ] || fail "mount identity marker records a different container name."
    for field in $DX_MOUNT_RESOURCE_FIELDS; do recorded="DX_RECORDED_$field"; [ -z "${!recorded:-}" ] || [ "${!recorded}" = "$(plan_field_value "$field")" ] || fail "container $container_name's resolved $field does not match its recorded manifest."; done
elif [ "$marker_present" = true ] && [ -n "$container_override" ] && container_exists "$container_name"; then
    [ "${DX_RECORDED_GIT_MOUNT_SOURCE:-}" = "$mount_source" ] || fail "container $container_name is recorded for a different mount source."
fi
if ! container_exists "$container_name" && dx_port_in_use "$DX_SSH_PORT"; then fail "SSH port $DX_SSH_PORT is already in use on 127.0.0.1."; fi
if [ "$marker_present" = false ]; then
    dx_mount_manifest_load_plan_values
    status=0
    dx_mount_manifest_publish_new "$identity_file" || status=$?
    if [ "$status" -ne 0 ]; then
        [ "$status" -eq 2 ] || exit "$status"
        dx_mount_manifest_secure_read "$identity_file"
    fi
fi
echo "Bringing up mount side container $container_name..."
echo "Mounting $DX_GIT_MOUNT_SOURCE at $DX_GIT_MOUNT_TARGET"
release_lock
exec "$SCRIPT_DIR/dx"
