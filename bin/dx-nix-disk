#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

nix_disk_main() {
# Branch 11 / Phase 5 (qnap-dxe-plan.md DQ8; docs/refactor/remote-aware-ssh.md
# section 7): Apple-only, fails before any mutation (including the
# "already exists" no-op check below) rather than preparing a sparse image
# a docker-ssh profile could never use.
dx_runtime_capability raw_nix_disk || { echo "Error: dx-nix-disk is Apple-only: DX_RUNTIME=${DX_RUNTIME:-apple} has no raw_nix_disk capability (qnap-dxe-plan.md DQ8)." >&2; exit 1; }

if [ -f "$DX_NIX_DISK" ]; then
    echo "Nix disk image already exists at $DX_NIX_DISK. Skipping."
    exit 0
fi

echo "Creating Nix disk image: $DX_NIX_DISK ($DX_NIX_DISK_SIZE)"
mkdir -p "$(dirname "$DX_NIX_DISK")"
truncate -s "$DX_NIX_DISK_SIZE" "$DX_NIX_DISK"

# No formatting happens here, on purpose, not as a placeholder: this is the
# host side of Apple's apple-image storage mode
# (docs/lifecycle.md's "Storage mode is explicit, not inferred" section),
# where the sparse file above is staged for Apple's own runtime at
# /var/lib/dx-nix-raw (bin/lib/dx-runtime-apple.sh) and the GUEST bootstrap's
# prepare_nix_volume formats it (mkfs.btrfs or mkfs.ext4, its choice) and
# mounts it onto /nix (docs/refactor/direct-volume-storage.md section 2).
# docker-ssh has no equivalent call into this file at all (DQ8): its
# direct-volume mode mounts a Docker named volume straight at /nix with no
# sparse image, no formatting, and no /etc/fstab edit.
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then nix_disk_main "$@"; fi
