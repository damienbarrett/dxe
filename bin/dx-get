#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

SOURCE="${1:-}"
DEST="${2:-.}"

if [ -z "$SOURCE" ]; then
    echo "Usage: dx-get <container_source_path> [host_destination_path]"
    exit 1
fi

# Check if source exists in container
if ! container exec "$DX_CONTAINER_NAME" [ -e "$SOURCE" ]; then
    echo "Error: Source path '$SOURCE' does not exist in container $DX_CONTAINER_NAME."
    exit 1
fi

# Determine if source is a directory in the container
IS_DIR=0
if container exec "$DX_CONTAINER_NAME" [ -d "$SOURCE" ]; then
    IS_DIR=1
fi

echo "Copying $DX_CONTAINER_NAME:$SOURCE to $DEST"

# Handle destination directory logic
if [[ "$DEST" == */ ]] || [ -d "$DEST" ]; then
    mkdir -p "$DEST"
    if [ "$IS_DIR" -eq 1 ]; then
        FINAL_DEST_DIR="$DEST"
    else
        FINAL_DEST="$DEST/$(basename "$SOURCE")"
    fi
else
    FINAL_DEST="$DEST"
    PARENT_DIR=$(dirname "$FINAL_DEST")
    mkdir -p "$PARENT_DIR"
fi

if [ "$IS_DIR" -eq 1 ]; then
    # For directory, we'll tar it from the container
    container exec "$DX_CONTAINER_NAME" tar -C "$(dirname "$SOURCE")" -cf - "$(basename "$SOURCE")" | tar -xf - -C "${FINAL_DEST_DIR:-$(dirname "$FINAL_DEST")}"
else
    # For file, we'll cat it from the container
    container exec "$DX_CONTAINER_NAME" cat "$SOURCE" > "$FINAL_DEST"
fi
