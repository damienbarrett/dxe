#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

SOURCE="${1:-}"
DEST="${2:-.}"

if [ -z "$SOURCE" ]; then
    echo "Usage: dx-get <container_source_path> [host_destination_path]"
    exit 1
fi

# Check if source exists in container
if ! container exec "$DX_CONTAINER_NAME" [ -e "$SOURCE" ]; then
    echo "Error: Source path '$SOURCE' does not exist in container $DX_CONTAINER_NAME."
    exit 1
fi

# Determine if source is a directory in the container
IS_DIR=0
if container exec "$DX_CONTAINER_NAME" [ -d "$SOURCE" ]; then
    IS_DIR=1
fi

echo "Copying $DX_CONTAINER_NAME:$SOURCE to $DEST"

if [ "$IS_DIR" -eq 1 ]; then
    # Directory: standard cp -r semantics. A destination ending in / or
    # already an existing directory means "copy INTO it", landing at
    # DEST/basename(SOURCE). Any other destination names the copy itself
    # ("copy AS"), so extraction strips the leading basename(SOURCE)/ path
    # component and SOURCE's contents land directly in DEST instead of a
    # nested DEST/basename(SOURCE).
    if [[ "$DEST" == */ ]] || [ -d "$DEST" ]; then
        mkdir -p "$DEST"
        container exec "$DX_CONTAINER_NAME" tar -C "$(dirname "$SOURCE")" --exclude '._*' -cf - "$(basename "$SOURCE")" \
            | tar -xf - -C "$DEST"
    else
        mkdir -p "$DEST"
        container exec "$DX_CONTAINER_NAME" tar -C "$(dirname "$SOURCE")" --exclude '._*' -cf - "$(basename "$SOURCE")" \
            | tar -xf - -C "$DEST" --strip-components=1
    fi
else
    # File: land at DEST/basename(SOURCE) if DEST is/looks like a directory,
    # otherwise DEST is the exact destination path.
    if [[ "$DEST" == */ ]] || [ -d "$DEST" ]; then
        mkdir -p "$DEST"
        FINAL_DEST="$DEST/$(basename "$SOURCE")"
    else
        FINAL_DEST="$DEST"
        mkdir -p "$(dirname "$FINAL_DEST")"
    fi
    container exec "$DX_CONTAINER_NAME" cat "$SOURCE" > "$FINAL_DEST"
fi
