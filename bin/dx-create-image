#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if container_image_exists "$DX_IMAGE"; then
    echo "Image $DX_IMAGE already exists; skipping build."
    exit 0
fi

CONTEXT_DIR="$DX_PROJECT_ROOT/container/aarch64-darwin-apple-container-dx-nixos-25.11"
echo "Building image $DX_IMAGE from $CONTEXT_DIR..."
container build -t "$DX_IMAGE" "$CONTEXT_DIR"
