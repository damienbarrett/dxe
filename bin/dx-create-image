#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

if container_image_exists "$DX_IMAGE"; then
    echo "Image $DX_IMAGE already exists; skipping build."
    exit 0
fi

echo "Building image $DX_IMAGE from $DX_CONTEXT_DIR..."
container build -t "$DX_IMAGE" "$DX_CONTEXT_DIR"
