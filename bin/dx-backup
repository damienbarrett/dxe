#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

backup_main() {
dx_require_container_cli
# shellcheck source=lib/dx-backup.sh
source "$SCRIPT_DIR/lib/dx-backup.sh"

DRY_RUN=false
SUMMARY=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --summary) SUMMARY=true ;;
        --help)
            echo "Usage: dx-backup [--dry-run [--summary]]"
            echo "Capture the at-risk contents of /persist into DX_BACKUP_DIR (default: \$HOME/Backups/dxe-persist/\$DX_CONTAINER_NAME)."
            echo "  --dry-run           show what would be transferred/removed, without changing anything."
            echo "  --dry-run --summary show the at-risk selection's size, aggregated by top-level directory and by reason, instead of a full per-file listing."
            exit 0
            ;;
        *) echo "Error: unrecognized argument '$arg'. Usage: dx-backup [--dry-run [--summary]]" >&2; exit 64 ;;
    esac
done

if [ "$SUMMARY" = true ] && [ "$DRY_RUN" != true ]; then
    echo "Error: --summary requires --dry-run. Usage: dx-backup [--dry-run [--summary]]" >&2
    exit 64
fi

# Resolved and validated BEFORE any container/guest call (Astra F6 / Muse
# B3 / WP3.3 defect C): dx_backup_read_exclude_patterns correctly returns
# failure and prints an Error naming an unreadable explicit
# DX_BACKUP_EXCLUDE_FILE, but running it inside `done < <(...)` -- a
# process substitution -- let the surrounding `while` loop's own exit
# status (reading zero lines from a closed, empty pipe) mask that failure:
# backup continued with an empty extra deny-list instead of aborting,
# potentially copying data the operator explicitly meant to exclude. Its
# output is read into a real temp file first so the function's own exit
# status can be checked directly, and the check happens before
# container_exists/container_is_running below so a bad exclude file is
# never worth even a single guest round trip.
DENY_PATTERNS=()
EXCLUDE_FILE="$(dx_backup_resolve_exclude_file)"
if [ -n "$EXCLUDE_FILE" ]; then
    EXCLUDE_PATTERNS_TMP="$(mktemp "${TMPDIR:-/tmp}/dxe-dx-backup-exclude.XXXXXX")"
    if ! dx_backup_read_exclude_patterns "$EXCLUDE_FILE" > "$EXCLUDE_PATTERNS_TMP"; then
        rm -f "$EXCLUDE_PATTERNS_TMP"
        exit 1
    fi
    while IFS= read -r pattern; do
        DENY_PATTERNS+=("$pattern")
    done < "$EXCLUDE_PATTERNS_TMP"
    rm -f "$EXCLUDE_PATTERNS_TMP"
fi

container_exists "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME does not exist. Run ./bin/dx-create-container first." >&2; exit 1; }
container_is_running "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME is not running. Run ./bin/dx-start-container first." >&2; exit 1; }

BACKUP_DIR="$(dx_backup_resolve_dir)"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/dxe-dx-backup.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
LISTING="$WORK/listing.tsv"
FETCH="$WORK/fetch.tsv"
REMOVE="$WORK/remove.txt"

if [ "$SUMMARY" = true ]; then
    echo "Selecting at-risk content from $DX_CONTAINER_NAME:/persist (summary)..."
    LISTING_REASON="$WORK/listing-reason.tsv"
    dx_backup_fetch_listing_with_reason "$DX_CONTAINER_NAME" "${DENY_PATTERNS[@]+"${DENY_PATTERNS[@]}"}" > "$LISTING_REASON"
    dx_backup_summarize "$LISTING_REASON"
    exit 0
fi

# Astra F5 / WP6.6: one lock, shared with dx-restore (bin/lib/dx-host-util.sh's
# dx_lock_acquire), over the whole mirror directory -- taken only for a REAL
# (mutating) run, never for --dry-run/--summary above (which read only the
# guest listing and the OLD manifest, never `current` itself, and must
# create nothing on disk -- an existing, tested contract), held until this
# process exits (successfully, on error, or on a trapped signal), so two
# real dx-backup runs -- or a real run and a dx-restore -- against the SAME
# mirror can never interleave their own reads/writes of it. A run that
# cannot get the lock within the timeout refuses with dx_lock_acquire's own
# clear error naming the lock path, rather than waiting forever or racing
# ahead anyway.
if [ "$DRY_RUN" != true ]; then
    mkdir -p "$BACKUP_DIR"
    BACKUP_LOCK="$BACKUP_DIR/.lock"
    dx_lock_acquire "$BACKUP_LOCK" "${DX_TUNNEL_LOCK_TIMEOUT:-5}" || exit 1
    trap 'rm -rf "$WORK"; dx_lock_release "$BACKUP_LOCK" >/dev/null 2>&1 || true' EXIT
    # Astra F5 / WP6.9 follow-up: a mirror created before this generation
    # model existed (current/ a real directory, manifest.tsv beside it) is
    # adopted in place -- once, idempotently, under this same lock -- before
    # selection, so the diff below reads its real history instead of
    # treating a pre-existing mirror as empty.
    dx_backup_generation_migrate_legacy "$BACKUP_DIR" || exit 1
fi

MANIFEST="$(dx_backup_generation_manifest_path "$BACKUP_DIR")"

echo "Selecting at-risk content from $DX_CONTAINER_NAME:/persist..."
dx_backup_fetch_listing "$DX_CONTAINER_NAME" "${DENY_PATTERNS[@]+"${DENY_PATTERNS[@]}"}" > "$LISTING"

dx_backup_diff "$MANIFEST" "$LISTING" "$FETCH" "$REMOVE"
fetch_count="$(wc -l < "$FETCH" | tr -d '[:space:]')"
fetch_bytes="$(dx_backup_sum_sizes "$FETCH")"
remove_count="$(wc -l < "$REMOVE" | tr -d '[:space:]')"
# A mirror whose published generation has no dirs.tsv (made before directory
# modes were captured) gets one committing run that records them, even with no
# file change; the run after that is a no-op again.
dir_modes_upgrade=false
if dx_backup_generation_needs_dir_modes "$BACKUP_DIR"; then dir_modes_upgrade=true; fi

if [ "$DRY_RUN" = true ]; then
    echo "Dry run: destination $BACKUP_DIR"
    if [ "${fetch_count:-0}" -gt 0 ]; then
        echo "Would transfer:"
        cut -f1 "$FETCH" | sed 's/^/  /'
    fi
    if [ "${remove_count:-0}" -gt 0 ]; then
        echo "Would remove from the mirror (no longer at-risk):"
        sed 's/^/  /' "$REMOVE"
    fi
    if [ "$dir_modes_upgrade" = true ]; then
        echo "Would record directory modes for this mirror (one-time metadata upgrade)."
    fi
    echo "${fetch_count:-0} files, ${fetch_bytes:-0} bytes would be transferred."
    exit 0
fi

if [ "${fetch_count:-0}" -gt 0 ] || [ "${remove_count:-0}" -gt 0 ] || [ "$dir_modes_upgrade" = true ]; then
    if [ "$dir_modes_upgrade" = true ]; then
        echo "Recording directory modes for this mirror (one-time metadata upgrade)..."
    fi
    if [ "${fetch_count:-0}" -gt 0 ]; then
        echo "Fetching ${fetch_count} changed file(s)..."
    fi
    if [ "${remove_count:-0}" -gt 0 ]; then
        echo "Removing ${remove_count} path(s) no longer at-risk from the mirror..."
    fi
    # Astra F5 / WP6.6: the whole "stage a new generation, verify it,
    # publish it, retire the one before it" sequence, all-or-nothing -- see
    # bin/lib/dx-backup.sh's own comment above dx_backup_generation_commit.
    dx_backup_generation_commit "$DX_CONTAINER_NAME" "$BACKUP_DIR" "$LISTING" "$FETCH" "$REMOVE" >/dev/null
fi

summary="${fetch_count:-0} files, ${fetch_bytes:-0} bytes transferred."
echo "$summary"
{
    printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ) $summary"
    [ "${remove_count:-0}" -eq 0 ] || printf '%s\n' "  removed from mirror: ${remove_count} path(s)"
} >> "$BACKUP_DIR/last-run.log"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then backup_main "$@"; fi
