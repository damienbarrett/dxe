#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

echo "Entering DX container: $DX_CONTAINER_NAME"
if [ $# -eq 0 ]; then
    container exec -it "$DX_CONTAINER_NAME" bash -l
else
    container exec -it "$DX_CONTAINER_NAME" bash -lc "$(printf "%q " "$@")"
fi
