#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DX_PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/dx-config.sh
source "$SCRIPT_DIR/lib/dx-config.sh"

usage() {
    echo "Usage: $(basename "$0") <profile> <command...>" >&2
    echo "Available profiles:" >&2
    for directory in "$PROFILES_DIR" ${BUNDLED_PROFILES_DIR:+"$BUNDLED_PROFILES_DIR"}; do
        [ -d "$directory" ] || continue
        for file in "$directory"/*.env; do
            [ -f "$file" ] && echo "  $(basename "$file" .env) ($directory)" >&2
        done
    done
}

profile_main() {
PROFILES_DIR="${DX_PROFILES_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/dxe/profiles}"
BUNDLED_PROFILES_DIR=""
if [ -z "${DX_PROFILES_DIR:-}" ]; then
    BUNDLED_PROFILES_DIR="$DX_PROJECT_ROOT/tests/profiles"
fi
[ "$#" -ge 2 ] || { usage; exit 2; }
profile=$1
shift
case "$profile" in
    ''|[.-]*|*[!A-Za-z0-9_.-]*) echo "Error: invalid profile name '$profile'." >&2; exit 2 ;;
esac
profile_file="$PROFILES_DIR/$profile.env"
if [ ! -f "$profile_file" ] && [ -n "$BUNDLED_PROFILES_DIR" ]; then
    profile_file="$BUNDLED_PROFILES_DIR/$profile.env"
fi
[ -f "$profile_file" ] || {
    echo "Error: Profile not found: $PROFILES_DIR/$profile.env${BUNDLED_PROFILES_DIR:+ (also checked $BUNDLED_PROFILES_DIR/$profile.env)}" >&2
    exit 1
}

export DX_PROJECT_ROOT
dx_parse_config_file "$profile_file"
for name in $DXE_CONFIG_FIELDS; do
    parsed_name="DXE_PARSED_$name"
    if [ "${!parsed_name+x}" = x ]; then
        printf -v "$name" '%s' "${!parsed_name}"
        origin_name="DXE_CONFIG_ORIGIN_$name"
        printf -v "$origin_name" '%s' "profile:$profile"
        export "${name?}" "${origin_name?}"
    fi
    unset "$parsed_name"
done
unset DXE_CONFIG_RESOLVED DXE_CONFIG_SNAPSHOT_VERSION
dx_init_config "$DX_PROJECT_ROOT"
exec "$@"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then profile_main "$@"; fi
