#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DX_PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=lib/dx-config.sh
source "$SCRIPT_DIR/lib/dx-config.sh"

profile_main() {
    [ "$#" -ge 2 ] || { dx_profile_usage "$(basename "$0")"; exit 2; }
    local profile=$1 profile_file
    shift
    profile_file="$(dx_profile_resolve_file "$profile")" || exit $?
    export DX_PROJECT_ROOT
    dx_profile_apply "$profile" "$profile_file" || exit $?
    exec "$@"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then profile_main "$@"; fi
