#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if [ "${1:-}" = "--tunnel-state" ]; then
    [ "$#" -eq 1 ] || { echo "Usage: $(basename "$0") --tunnel-state" >&2; exit 2; }
    original_container=$DX_CONTAINER_NAME
    containers=" $DX_CONTAINER_NAME "
    profiles_dir="${DX_PROFILES_DIR:-$DX_PROJECT_ROOT/tests/profiles}"
    if [ -d "$profiles_dir" ]; then
        for profile_file in "$profiles_dir"/*.env; do
            [ -f "$profile_file" ] || continue
            dx_parse_config_file "$profile_file" >/dev/null
            profile_container=${DXE_PARSED_DX_CONTAINER_NAME:-$original_container}
            case "$containers" in *" $profile_container "*) ;; *) containers="$containers$profile_container " ;; esac
        done
    fi
    total=0
    for DX_CONTAINER_NAME in $containers; do
        for direction in forward reverse; do
            while IFS="$(printf '\t')" read -r key socket; do
                [ -n "$key" ] || continue
                case "$socket" in "$(dx_tunnel_state_dir)"/*) layout=v1 ;; *) layout=legacy ;; esac
                printf '%s container=%s port=%s layout=%s socket=%s\n' "$direction" "$DX_CONTAINER_NAME" "$key" "$layout" "$socket"
                total=$((total + 1))
            done < <(dx_tunnel_discover "$direction")
        done
    done
    DX_CONTAINER_NAME=$original_container
    [ "$total" -gt 0 ] || echo "No tunnel state found for configured profiles."
    exit 0
fi

[ "$#" -eq 0 ] || { echo "Usage: $(basename "$0") [--tunnel-state]" >&2; exit 2; }
dx_require_container_cli

echo "=== DX Status ==="
echo "--- Image ($DX_IMAGE) ---"
if container_image_exists "$DX_IMAGE"; then
    container image list | grep "^${DX_IMAGE}[[:space:]]"
else
    echo "Not found"
fi

echo -e "\n--- Container ($DX_CONTAINER_NAME) ---"
if container_exists "$DX_CONTAINER_NAME"; then
    container list -a | grep "^${DX_CONTAINER_NAME}[[:space:]]"
    if ! container_is_running "$DX_CONTAINER_NAME"; then
        echo
        echo "Container is not running. Last 40 log lines:"
        container logs -n 40 "$DX_CONTAINER_NAME" 2>&1 | sed 's/^/  /'
    fi
else
    echo "Not found"
fi

echo -e "\n--- Bootstrap Generation ---"
if container_exists "$DX_CONTAINER_NAME"; then
    if container_is_running "$DX_CONTAINER_NAME"; then
        # Same reads dx-start-container makes right after a sync (see there for
        # why each is allowed to fail silently): `container exec` is available
        # here because the guest is up, which is also the one case where the
        # guest itself already told the operator this in real time.
        dx_published_generation="$(container exec "$DX_CONTAINER_NAME" readlink "$DX_BOOTSTRAP_PATH/current" 2>/dev/null || true)"
        dx_published_generation="${dx_published_generation#generations/}"
        dx_lease_listing="$(container exec "$DX_CONTAINER_NAME" sh -c 'ls -1 "$1/.locks/leases" 2>/dev/null || true' -- "$DX_BOOTSTRAP_PATH" 2>/dev/null || true)"
        dx_running_generation=""
        [ -z "$dx_lease_listing" ] || dx_running_generation="$(dx_bootstrap_lease_generation "$dx_lease_listing" || true)"
        echo "Running:   ${dx_running_generation:-unknown (no execution lease yet)}"
        echo "Published: ${dx_published_generation:-unknown (never synced)}"
        dx_bootstrap_report_drift "$dx_running_generation" "$dx_published_generation" "$DX_CONTAINER_NAME"
    else
        # `container exec` needs a running container, so none of the reads
        # above are possible here -- exactly the case (dx-start-plan.md,
        # requirement 4) where the question matters most: a guest that died.
        # `container logs` does not need a running container, and the
        # launcher names its resolved generation there before it execs that
        # generation's bootstrap.sh (dx_bootstrap_launch_command, in
        # bin/lib/dx-ssh-common.sh) -- the only record of which payload a
        # dead guest actually ran. The Container section above already tails
        # the last 40 log lines, which this boot line does not reliably
        # survive into (a noisy bootstrap or SSH session traffic pushes it
        # out), so this reads the full log rather than a tail.
        dx_boot_log="$(container logs "$DX_CONTAINER_NAME" 2>/dev/null || true)"
        dx_last_boot_generation="$(printf '%s\n' "$dx_boot_log" | { grep 'Using bootstrap generation' || true; } | tail -1)"
        if [ -n "$dx_last_boot_generation" ]; then
            echo "Guest is not running. Last recorded boot: $dx_last_boot_generation"
        else
            echo "Guest is not running; no recorded boot generation (never synced, or predates this diagnostic)."
        fi
    fi
else
    echo "Not found"
fi

echo -e "\n--- SSH (localhost:$DX_SSH_PORT) ---"
if nc -z localhost "$DX_SSH_PORT" 2>/dev/null; then
    echo "SSH Port $DX_SSH_PORT is OPEN on localhost"
else
    echo "SSH Port $DX_SSH_PORT is CLOSED on localhost"
fi

echo -e "\n--- Guest Environment ---"
if container_is_running "$DX_CONTAINER_NAME"; then
    container exec -u dx "$DX_CONTAINER_NAME" bash -lc "echo -n 'Tools: ' && command -v nvim && command -v nix && command -v tmux && echo -n 'Persist: ' && df -h /persist | tail -1"

    echo -e "\ntmux sessions:"
    container exec -u dx "$DX_CONTAINER_NAME" bash -lc "tmux ls 2>/dev/null" || echo "No active tmux sessions"
else
    echo "Container is not running or not found"
fi
