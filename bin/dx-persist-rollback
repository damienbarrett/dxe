#!/bin/bash
# Rollback of a guest's /persist from its NAS host directory into a NEW named
# volume (spec R36, section 6.1). The logic is dx_persist_rollback_main in
# bin/lib/dx-persist-dir.sh; stop the guest, then select it like the sibling
# commands:
#   ./bin/dx-profile <profile> ./bin/dx-persist-rollback --volume <new volume>
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
# The entry-point contract (tests/test_refactor_contracts.sh) wants <name>_main
# defined in the entry point itself.
persist_rollback_main() { dx_persist_rollback_main "$@"; }
if [ "${BASH_SOURCE[0]}" = "$0" ]; then persist_rollback_main "$@"; fi
