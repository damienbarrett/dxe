#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if [ ! -f "$DX_SSH_KEY" ]; then
    echo "Error: SSH key file not found at $DX_SSH_KEY." >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    # No arguments: interactive login to tmux. dx_run_interactive_ssh (shared
    # with dx-herdr) owns the "Connecting..." banner, the timezone lookup, the
    # SSH options, the guest env prefix/workdir snippet, and the
    # terminal-colour cleanup trap -- see F3/F10 in herdr-refactor.md.
    REMOTE_TMUX_CMD="if [ -x /home/dx/.local/bin/dx-theme-restore ]; then /home/dx/.local/bin/dx-theme-restore 2>/dev/null || true; fi; if ! command -v tmux >/dev/null 2>&1; then echo \"DX guest tools are still bootstrapping; tmux is not available yet.\" >&2; exit 127; fi; tmux attach -t dx || tmux new-session -s dx"
    dx_run_interactive_ssh "$REMOTE_TMUX_CMD"
else
    # Arguments provided: run them through bash so shell syntax is stable even
    # when the user's login shell is fish or nushell. The base64 transport is
    # deliberate (survives any login shell's quoting rules) and is unchanged;
    # only the SSH options and the env-prefix/bash-lc boundary now come from
    # the single source of truth in dx-ssh-common.sh (F10).
    echo "Connecting to DX guest via SSH..." >&2
    HOST_TZ="$(dx_get_host_timezone)"

    # Revert terminal colors to host defaults upon exit. Keep terminal-control
    # diagnostics off stdout so `dx-ssh <command>` remains safe to capture.
    trap 'printf "\033]110\033\\\\\033]111\033\\\\\033]104\033\\\\" >&2' EXIT

    SSH_OPTS=() SSH_OPT=""
    while IFS= read -r SSH_OPT; do SSH_OPTS+=("$SSH_OPT"); done <<<"$(dx_ssh_common_options)"

    # The workdir snippet belongs on the *decoded* user command, applied by
    # the inner login shell right before it runs -- exactly as before this
    # refactor -- not on this outer transport wrapper (dx_guest_bash_command's
    # automatic prepend is for callers with a single bash -l, e.g. the
    # interactive path and dx-herdr's probes; it is deliberately not used
    # here so the workdir application point does not move).
    USER_COMMAND="$(dx_guest_workdir_snippet)$*"
    ENCODED_COMMAND="$(printf '%s' "$USER_COMMAND" | base64 | tr -d '\n')"
    REMOTE_COMMAND="$(dx_guest_env_prefix "$HOST_TZ") bash -lc 'printf %s $ENCODED_COMMAND | base64 -d | bash -l'"
    ssh "${SSH_OPTS[@]}" "$(dx_ssh_endpoint)" "$REMOTE_COMMAND"
fi
