#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if [ ! -f "$DX_SSH_KEY" ]; then
    echo "Error: SSH key file not found at $DX_SSH_KEY"
    exit 1
fi

echo "Connecting to DX guest via SSH..."

# Ensure TERM is compatible with the guest
export TERM=${TERM:-xterm-256color}

# Revert terminal colors to host defaults upon exit
trap 'printf "\033]110\033\\\\\033]111\033\\\\\033]104\033\\\\"' EXIT

# Use a bash array for SSH options to handle quoting correctly
SSH_OPTS=(
    "-i" "$DX_SSH_KEY"
    "-p" "$DX_SSH_PORT"
    "-o" "StrictHostKeyChecking=no"
    "-o" "UserKnownHostsFile=/dev/null"\
    "-o" "IdentitiesOnly=yes"
)

# Baseline path and SSL certs to ensure Nix tools are found and work
GUEST_PATH="/home/dx/.nix-profile/bin:/home/dx/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
GUEST_SSL="SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt"

if [ $# -eq 0 ]; then
    # No arguments: interactive login to tmux
    # We explicitly invoke bash for the environment setup check to handle POSIX syntax (e.g. 2>&1)
    # regardless of the user's default login shell (nushell/fish).
    # We also pass the PATH and a safe TERM via env to ensure bash/tmux can find everything.
    REMOTE_COMMAND="env PATH=\"$GUEST_PATH\" $GUEST_SSL TERM=xterm-256color bash -l -c 'if [ -x /home/dx/.local/bin/dx-theme-restore ]; then /home/dx/.local/bin/dx-theme-restore 2>/dev/null || true; fi; if ! command -v tmux >/dev/null 2>&1; then echo \"DX guest tools are still bootstrapping; tmux is not available yet.\" >&2; exit 127; fi; tmux attach -t dx || tmux new-session -s dx'"
    ssh -t "${SSH_OPTS[@]}" dx@127.0.0.1 "$REMOTE_COMMAND"
else
    # Arguments provided: run them through bash so shell syntax is stable even
    # when the user's login shell is fish or nushell.
    USER_COMMAND="$*"
    ENCODED_COMMAND="$(printf '%s' "$USER_COMMAND" | base64 | tr -d '\n')"
    REMOTE_COMMAND="env PATH=\"$GUEST_PATH\" $GUEST_SSL TERM=xterm-256color bash -lc 'printf %s $ENCODED_COMMAND | base64 -d | bash -l'"
    ssh "${SSH_OPTS[@]}" dx@127.0.0.1 "$REMOTE_COMMAND"
fi
