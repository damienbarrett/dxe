#!/bin/bash
set -euo pipefail

# dx-factory-reset
# Removes every host-side artefact: container, image, persistent volumes,
# and the SSH keypair. The /nix store and /persist contents are GONE after
# this — re-downloading Nix takes hours. Prompts once for confirmation; pass
# --force to skip.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

force=0
for arg in "$@"; do
    case "$arg" in
        --force|-f) force=1 ;;
        *)
            echo "Error: Unknown argument: $arg (only --force / -f is accepted)" >&2
            exit 2
            ;;
    esac
done

# Branch 11 / Phase 6 (qnap-dxe-plan.md Phase 6 item 7): the whole-operation
# ownership proof, printed and verified before any prompt or deletion --
# refuses the WHOLE factory reset (nothing touched) if the container or any
# EXISTING volume fails its DQ6 label check, rather than a partial destroy
# part-way through the sequence below. Images have no DQ6 labels at all
# (documented adapter limitation: Docker's `tag` cannot attach one), so
# dx-destroy-image's own exact-name addressing is the only protection there,
# unchanged. A no-op under DX_RUNTIME=apple (Apple has no DQ6 labels at
# all), so Apple's behaviour below is unaffected, byte for byte.
dx_destructive_plan_and_verify \
    "container:$DX_CONTAINER_NAME:container" \
    "volume:$DX_NIX_VOLUME:nix" \
    "volume:$DX_PERSIST_VOLUME:persist" \
    "volume:$DX_BOOTSTRAP_VOLUME:bootstrap" \
    || {
        echo "Error: refusing to factory-reset: the plan above found a resource that does not belong to this profile (qnap-dxe-plan.md DQ6)." >&2
        exit 1
    }

if [ "$force" -ne 1 ]; then
    if [ ! -t 0 ]; then
        echo "Error: Refusing to factory-reset without --force when stdin is not a tty." >&2
        exit 1
    fi

    echo "Factory reset will remove ALL of the following:"
    echo "  - Container $DX_CONTAINER_NAME"
    echo "  - Image $DX_IMAGE"
    echo "  - Volume $DX_NIX_VOLUME (Nix store — re-download takes hours)"
    echo "  - Volume $DX_PERSIST_VOLUME (Your work in /persist — IRREVERSIBLE)"
    echo "  - Volume $DX_BOOTSTRAP_VOLUME (Bootstrap payload — auto-rebuilt)"
    echo "  - SSH keypair $DX_SSH_KEY / $DX_SSH_KEY_PUB"
    echo
    printf 'Type "factory-reset" to confirm: '
    read -r reply
    if [ "$reply" != "factory-reset" ]; then
        echo "Confirmation not received; aborting." >&2
        exit 1
    fi
fi

echo "Performing factory reset..."

"$SCRIPT_DIR/dx-destroy-container"
"$SCRIPT_DIR/dx-destroy-image"
"$SCRIPT_DIR/dx-destroy-volumes" --force
"$SCRIPT_DIR/dx-destroy-keys"

echo "Factory reset complete."
