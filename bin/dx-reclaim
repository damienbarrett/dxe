#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

rule() {
    printf '%s\n' "------------------------------------------------------------"
}

volume_image_path() {
    local volume="$1"
    printf '%s\n' "$DX_CONTAINER_VOLUME_DIR/$volume/volume.img"
}

host_image_size() {
    local image="$1"
    if [ ! -f "$image" ]; then
        printf 'missing'
        return 0
    fi

    du -sh "$image" 2>/dev/null | cut -f1
}

# Nix must run as dx: the store is single-user dx-owned, and a root-invoked
# nix re-owns /nix/store to root:nixbld, locking dx out.
run_in_guest() {
    container exec -u dx "$DX_CONTAINER_NAME" /usr/bin/bash -lc "$1"
}

report_host_images() {
    echo "Host sparse image usage:"
    printf '  %-14s %s\n' "$DX_NIX_VOLUME" "$(host_image_size "$(volume_image_path "$DX_NIX_VOLUME")")"
    printf '  %-14s %s\n' "$DX_PERSIST_VOLUME" "$(host_image_size "$(volume_image_path "$DX_PERSIST_VOLUME")")"
}

report_guest_filesystems() {
    echo "Guest filesystem usage:"
    container exec "$DX_CONTAINER_NAME" /usr/bin/bash -lc '
        export PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"
        store_path="$1/store"
        store_usage="$(du -sh "$store_path" 2>/dev/null)" || exit $?
        store_size="${store_usage%%	*}"
        [ "$store_size" = "$store_usage" ] && store_size="${store_usage%% *}"
        printf "  %-14s %s\n" "$store_path" "$store_size"
        df_output="$(df -h "$@")" || exit $?
        while IFS= read -r line; do
            printf "  %s\n" "$line"
        done <<EOF
$df_output
EOF
    ' bash "$DX_NIX_MOUNT" /persist
}

report_usage() {
    report_host_images
    echo
    report_guest_filesystems
}

trim_mount() {
    local mount_path="$1"
    container exec "$DX_CONTAINER_NAME" /usr/bin/bash -lc '
        export PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"
        if fstrim -v "$1"; then
            exit 0
        fi
        echo "$1: trim not supported"
    ' bash "$mount_path"
}

if ! container_is_running "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME is not running. Start it first." >&2
    exit 1
fi

rule
echo "Before"
rule
report_usage

rule
echo "Running Nix garbage collection in guest..."
rule
run_in_guest "nix-collect-garbage -d"

rule
echo "Trimming guest filesystems..."
rule
trim_mount "$DX_NIX_MOUNT"
trim_mount /persist

rule
echo "After"
rule
report_usage

rule
echo "Reclaim complete."
