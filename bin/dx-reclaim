#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

rule() {
    printf '%s\n' "------------------------------------------------------------"
}

# Nix must run as dx: the store is single-user dx-owned, and a root-invoked
# nix re-owns /nix/store to root:nixbld, locking dx out.
run_in_guest() {
    dx_runtime_exec -u dx "$DX_CONTAINER_NAME" /usr/bin/bash -lc "$1"
}

# Branch 11 / Phase 3 (qnap-dxe-plan.md Phase 3 item 5): the capability-aware
# neutral op replaces this file's own host-filesystem read (Apple) / adds a
# Docker-native report where Apple had none. "Volume usage" (not "Host
# sparse image usage") because under docker-ssh this reports a remote
# Docker volume's size, never anything on the controller's own filesystem.
report_host_images() {
    echo "Volume usage:"
    printf '  %-14s %s\n' "$DX_NIX_VOLUME" "$(dx_runtime_volume_usage "$DX_NIX_VOLUME")"
    printf '  %-14s %s\n' "$DX_PERSIST_VOLUME" "$(dx_runtime_volume_usage "$DX_PERSIST_VOLUME")"
}

report_guest_filesystems() {
    echo "Guest filesystem usage:"
    dx_runtime_exec "$DX_CONTAINER_NAME" /usr/bin/bash -lc '
        export PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"
        store_path="$1/store"
        store_usage="$(du -sh "$store_path" 2>/dev/null)" || exit $?
        store_size="${store_usage%%	*}"
        [ "$store_size" = "$store_usage" ] && store_size="${store_usage%% *}"
        printf "  %-14s %s\n" "$store_path" "$store_size"
        df_output="$(df -h "$@")" || exit $?
        while IFS= read -r line; do
            printf "  %s\n" "$line"
        done <<EOF
$df_output
EOF
    ' bash "$DX_NIX_MOUNT" /persist
}

report_usage() {
    report_host_images
    echo
    report_guest_filesystems
}

trim_mount() {
    local mount_path="$1"
    dx_runtime_exec "$DX_CONTAINER_NAME" /usr/bin/bash -lc '
        export PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"
        if fstrim -v "$1"; then
            exit 0
        fi
        echo "$1: trim not supported"
    ' bash "$mount_path"
}

reclaim_main() {
dx_require_container_cli

if ! container_is_running "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME is not running. Start it first." >&2
    exit 1
fi

rule
echo "Before"
rule
report_usage

rule
echo "Running Nix garbage collection in guest..."
rule
run_in_guest "nix-collect-garbage -d"

rule
if dx_runtime_capability host_filesystem_reclamation; then
    echo "Trimming guest filesystems..."
    rule
    trim_mount "$DX_NIX_MOUNT"
    trim_mount /persist
else
    echo "Skipping filesystem trim: not supported against a Docker volume under this runtime (qnap-dxe-plan.md DQ4)."
fi

rule
echo "After"
rule
report_usage

rule
echo "Reclaim complete."
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then reclaim_main "$@"; fi
