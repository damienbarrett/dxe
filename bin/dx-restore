#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli
# shellcheck source=lib/dx-backup.sh
source "$SCRIPT_DIR/lib/dx-backup.sh"

DRY_RUN=false
FORCE=false
PATHS=()
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --force) FORCE=true ;;
        --help)
            echo "Usage: dx-restore [--dry-run] [--force] [PATH...]"
            echo "Push DX_BACKUP_DIR's current/ mirror (or the named PATHs within it) back into a running guest's /persist."
            exit 0
            ;;
        --*) echo "Error: unrecognized option '$arg'. Usage: dx-restore [--dry-run] [--force] [PATH...]" >&2; exit 64 ;;
        *) PATHS+=("$arg") ;;
    esac
done

container_exists "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME does not exist. Run ./bin/dx-create-container first." >&2; exit 1; }
container_is_running "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME is not running. dx-restore needs a running guest to push into." >&2; exit 1; }

BACKUP_DIR="$(dx_backup_resolve_dir)"
[ -d "$BACKUP_DIR/current" ] || { echo "Error: no backup mirror at $BACKUP_DIR/current. Run dx-backup first." >&2; exit 1; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/dxe-dx-restore.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
TARGETS="$WORK/targets.txt"
STATUS="$WORK/status.tsv"

if ! dx_backup_restore_targets "$BACKUP_DIR" "${PATHS[@]+"${PATHS[@]}"}" > "$TARGETS"; then
    exit 1
fi
if [ ! -s "$TARGETS" ]; then
    echo "Nothing to restore."
    exit 0
fi

dx_backup_restore_status "$DX_CONTAINER_NAME" "$BACKUP_DIR" "$TARGETS" > "$STATUS"

if [ "$DRY_RUN" = true ]; then
    while IFS="$(printf '\t')" read -r path status; do
        [ -n "$path" ] || continue
        case "$status" in
            create) echo "would create: $path" ;;
            identical) echo "already identical: $path" ;;
            conflict) echo "would OVERWRITE (conflicts with the guest): $path" ;;
        esac
    done < "$STATUS"
    exit 0
fi

conflicts="$(awk -F'\t' '$2 == "conflict" {print $1}' "$STATUS")"
if [ -n "$conflicts" ] && [ "$FORCE" != true ]; then
    echo "Error: the following target(s) already exist in the guest and differ from the backup; refusing without --force:" >&2
    printf '  %s\n' "$conflicts" >&2
    exit 1
fi

dx_backup_restore_push "$DX_CONTAINER_NAME" "$BACKUP_DIR" "$TARGETS"
count="$(wc -l < "$TARGETS" | tr -d '[:space:]')"
echo "Restored ${count} file(s) into $DX_CONTAINER_NAME:$DX_BACKUP_GUEST_ROOT."
