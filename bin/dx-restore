#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

restore_main() {
dx_require_container_cli
# shellcheck source=lib/dx-backup.sh
source "$SCRIPT_DIR/lib/dx-backup.sh"

DRY_RUN=false
FORCE=false
SOURCE_CONTAINER=""
PATHS=()
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
        --force) FORCE=true ;;
        --source-container=*) SOURCE_CONTAINER="${arg#--source-container=}" ;;
        --help)
            echo "Usage: dx-restore [--dry-run] [--force] [--source-container=NAME] [PATH...]"
            echo "Push DX_BACKUP_DIR's current/ mirror (or the named PATHs within it) back into a running guest's /persist."
            echo "  --source-container=NAME  read a DIFFERENT profile's mirror (by its DX_CONTAINER_NAME), still"
            echo "                           pushing into THIS profile's own running guest. Never the default; a"
            echo "                           plain 'dx-restore' never crosses profiles (qnap-dxe-plan.md Phase 7)."
            exit 0
            ;;
        --*) echo "Error: unrecognized option '$arg'. Usage: dx-restore [--dry-run] [--force] [--source-container=NAME] [PATH...]" >&2; exit 64 ;;
        *) PATHS+=("$arg") ;;
    esac
done

# --source-container=NAME (docs/refactor/qnap-promotion.md section B): fail
# closed on an invalid identifier before touching the filesystem or the
# guest, reusing DX_CONTAINER_NAME's own validator -- no new character-class
# rule. An explicit, correctly-shaped NAME is the only way to cross
# profiles; there is no fallback search and no "closest match."
if [ -n "$SOURCE_CONTAINER" ]; then
    dx_config_validate_value DX_CONTAINER_NAME "$SOURCE_CONTAINER" || { echo "Error: invalid --source-container value '$SOURCE_CONTAINER'." >&2; exit 64; }
fi

container_exists "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME does not exist. Run ./bin/dx-create-container first." >&2; exit 1; }
container_is_running "$DX_CONTAINER_NAME" || { echo "Error: Container $DX_CONTAINER_NAME is not running. dx-restore needs a running guest to push into." >&2; exit 1; }

# The cross-profile banner prints whenever the flag is given, before doing
# anything else (including under --dry-run) -- never silent about reading
# another profile's mirror (docs/refactor/qnap-promotion.md section B2).
if [ -n "$SOURCE_CONTAINER" ]; then
    echo "Restoring ${SOURCE_CONTAINER}'s backup into ${DX_CONTAINER_NAME} (cross-profile restore)."
fi

BACKUP_DIR="$(dx_backup_resolve_dir "$SOURCE_CONTAINER")"
[ -d "$BACKUP_DIR/current" ] || { echo "Error: no backup mirror at $BACKUP_DIR/current. Run dx-backup first." >&2; exit 1; }

WORK="$(mktemp -d "${TMPDIR:-/tmp}/dxe-dx-restore.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
TARGETS="$WORK/targets.txt"
STATUS="$WORK/status.tsv"

if ! dx_backup_restore_targets "$BACKUP_DIR" "${PATHS[@]+"${PATHS[@]}"}" > "$TARGETS"; then
    exit 1
fi
if [ ! -s "$TARGETS" ]; then
    echo "Nothing to restore."
    exit 0
fi

dx_backup_restore_status "$DX_CONTAINER_NAME" "$BACKUP_DIR" "$TARGETS" > "$STATUS"

if [ "$DRY_RUN" = true ]; then
    while IFS="$(printf '\t')" read -r path status; do
        [ -n "$path" ] || continue
        case "$status" in
            create) echo "would create: $path" ;;
            identical) echo "already identical: $path" ;;
            conflict) echo "would OVERWRITE (conflicts with the guest): $path" ;;
        esac
    done < "$STATUS"
    exit 0
fi

conflicts="$(awk -F'\t' '$2 == "conflict" {print $1}' "$STATUS")"
if [ -n "$conflicts" ] && [ "$FORCE" != true ]; then
    echo "Error: the following target(s) already exist in the guest and differ from the backup; refusing without --force:" >&2
    printf '  %s\n' "$conflicts" >&2
    exit 1
fi

PUSH_TARGETS="$WORK/push-targets.txt"
awk -F'\t' '$2 != "identical" { print $1 }' "$STATUS" > "$PUSH_TARGETS"
dx_backup_restore_push "$DX_CONTAINER_NAME" "$BACKUP_DIR" "$PUSH_TARGETS"
count="$(wc -l < "$PUSH_TARGETS" | tr -d '[:space:]')"
echo "Restored ${count} file(s) into $DX_CONTAINER_NAME:$DX_BACKUP_GUEST_ROOT."
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then restore_main "$@"; fi
