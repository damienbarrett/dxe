#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

if container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME already exists; skipping create."
    exit 0
fi

dx_nix_volume_claim_acquire "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME"
claim_pending=true
release_pending_claim() { [ "${claim_pending:-false}" != true ] || dx_nix_volume_claim_release "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME" || true; }
trap release_pending_claim EXIT HUP INT TERM

if ! container_image_exists "$DX_IMAGE"; then
    echo "Error: Image $DX_IMAGE does not exist. Run ./bin/dx-create-image first (or ./bin/dx, which builds it if missing)." >&2
    exit 1
fi

echo "Creating container $DX_CONTAINER_NAME from image $DX_IMAGE..."

BOOTSTRAP_LAUNCH_CMD="$(dx_bootstrap_launch_command)"

# Extract host timezone from macOS
HOST_TZ="$(dx_get_host_timezone)"
if [ -z "$HOST_TZ" ]; then
    echo "Warning: host timezone detection returned empty; defaulting guest timezone to UTC." >&2
    HOST_TZ="UTC"
fi

# Runtime-neutral parameters (qnap-dxe-plan.md DQ2: "runtime-specific CLI
# syntax ... lives only in the adapter"). Neither this script nor
# dx_runtime_container_create's own dispatch names a single Apple or
# Docker CLI flag; bin/lib/dx-runtime-apple.sh and
# bin/lib/dx-runtime-docker.sh each render their own real create argv from
# this vocabulary -- see bin/lib/dx-runtime.sh's own module comment for the
# complete parameter list and what each adapter does with it (in
# particular: the Nix volume's per-runtime mount target, and docker-ssh's
# restart-policy/DQ6-label handling that Apple has no equivalent of).
#
# Volume roles: nix -> the Nix store volume (each adapter decides its own
# mount target: Apple stages it for the guest to reformat at boot; the
# Docker adapter mounts it directly at /nix, per qnap-dxe-plan.md DQ4).
# persist -> the fixed guest path /persist. bootstrap -> DX_BOOTSTRAP_PATH.
CREATE_ARGS=(
    --name "$DX_CONTAINER_NAME"
    --image "$DX_IMAGE"
    --volume "nix:$DX_NIX_VOLUME:rw"
    --volume "persist:$DX_PERSIST_VOLUME:/persist:rw"
    --volume "bootstrap:$DX_BOOTSTRAP_VOLUME:$DX_BOOTSTRAP_PATH:rw"
    --env "HOST_TZ=$HOST_TZ"
    --env "DX_GUEST_ACTIVATION_TIMEOUT=$DX_GUEST_ACTIVATION_TIMEOUT"
    --env "DX_GUEST_ACTIVATION_ATTEMPTS=$DX_GUEST_ACTIVATION_ATTEMPTS"
    --env "DX_GUEST_ACTIVATION_RETRY_DELAY=$DX_GUEST_ACTIVATION_RETRY_DELAY"
    --env "DX_NIX_DISK_SIZE=$DX_NIX_DISK_SIZE"
    --memory "$DX_CONTAINER_MEMORY"
    --cpus "$DX_CONTAINER_CPUS"
    --publish "127.0.0.1:$DX_SSH_PORT:2222"
    --restart-policy "$DX_CONTAINER_RESTART_POLICY"
)

if [ -n "$DX_GIT_MOUNT_SOURCE" ]; then
    if [ "$DX_CONTAINER_NAME" = "dx-host" ]; then
        echo "Error: refusing to bind-mount host source into reserved container dx-host." >&2
        exit 1
    fi
    if [ ! -d "$DX_GIT_MOUNT_SOURCE" ]; then
        echo "Error: DX_GIT_MOUNT_SOURCE is not a directory: $DX_GIT_MOUNT_SOURCE" >&2
        exit 1
    fi
    CREATE_ARGS+=(--volume "git:$DX_GIT_MOUNT_SOURCE:$DX_GIT_MOUNT_TARGET:rw")
fi

if [ -f "$DX_SSH_KEY_PUB" ]; then
    DX_PUB_KEY=$(cat "$DX_SSH_KEY_PUB")
    CREATE_ARGS+=(--env "DX_PUB_KEY=$DX_PUB_KEY")
else
    echo "Warning: $DX_SSH_KEY_PUB not found. SSH access may not be configured."
fi

CREATE_ARGS+=(--entrypoint-cmd "$BOOTSTRAP_LAUNCH_CMD" --entrypoint-arg "$DX_BOOTSTRAP_PATH")

dx_runtime_container_create "${CREATE_ARGS[@]}"
claim_pending=false
trap - EXIT HUP INT TERM
