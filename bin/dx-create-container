#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME already exists; skipping create."
    exit 0
fi

if ! container_image_exists "$DX_IMAGE"; then
    echo "Error: Image $DX_IMAGE does not exist. Run ./bin/dx-create-image first (or ./bin/dx, which builds it if missing)." >&2
    exit 1
fi

echo "Creating container $DX_CONTAINER_NAME from image $DX_IMAGE..."

BOOTSTRAP_LAUNCH_CMD="$(dx_bootstrap_launch_command)"

# Extract host timezone from macOS
HOST_TZ="$(dx_get_host_timezone)"

# Volume mounts: DX_NIX_VOLUME -> /var/lib/dx-nix-raw (the bootstrap formats
# and remounts this at /nix); dx-persist -> /persist; dx-bootstrap ->
# /guest-bootstrap.
#
# CAP_SYS_ADMIN is required so the guest bootstrap can umount the
# runtime-provided mount at /var/lib/dx-nix-raw, mkfs it as btrfs/ext4, and
# remount it at /nix. Without it, bootstrap exits before sshd starts.
CREATE_FLAGS=(
    --name "$DX_CONTAINER_NAME"
    --entrypoint sh
    --cap-add CAP_SYS_ADMIN
    --volume "$DX_NIX_VOLUME:/var/lib/dx-nix-raw:rw"
    --volume "$DX_PERSIST_VOLUME:/persist:rw"
    --volume "$DX_BOOTSTRAP_VOLUME:$DX_BOOTSTRAP_PATH:rw"
    -e "HOST_TZ=$HOST_TZ"
    -m "$DX_CONTAINER_MEMORY" -c "$DX_CONTAINER_CPUS"
    -p "127.0.0.1:$DX_SSH_PORT:2222"
)

if [ -n "$DX_GIT_MOUNT_SOURCE" ]; then
    if [ "$DX_CONTAINER_NAME" = "dx-host" ]; then
        echo "Error: refusing to bind-mount host source into reserved container dx-host." >&2
        exit 1
    fi
    if [ ! -d "$DX_GIT_MOUNT_SOURCE" ]; then
        echo "Error: DX_GIT_MOUNT_SOURCE is not a directory: $DX_GIT_MOUNT_SOURCE" >&2
        exit 1
    fi
    CREATE_FLAGS+=(--volume "$DX_GIT_MOUNT_SOURCE:$DX_GIT_MOUNT_TARGET:rw")
fi

if [ -f "$DX_SSH_KEY_PUB" ]; then
    DX_PUB_KEY=$(cat "$DX_SSH_KEY_PUB")
    container create "${CREATE_FLAGS[@]}" -e "DX_PUB_KEY=$DX_PUB_KEY" "$DX_IMAGE" -c "$BOOTSTRAP_LAUNCH_CMD"
else
    echo "Warning: $DX_SSH_KEY_PUB not found. SSH access may not be configured."
    container create "${CREATE_FLAGS[@]}" "$DX_IMAGE" -c "$BOOTSTRAP_LAUNCH_CMD"
fi
