#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

release_pending_claim() {
    [ "${claim_pending:-false}" != true ] || dx_nix_volume_claim_release "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME" || true
    dx_lifecycle_lock_release || true
}

create_container_main() {
# Two published host ports cannot be the same port; refuse before touching the
# runtime. Off ignores DX_USAGE_SERVICE_HOST_PORT entirely.
if [ "$DX_USAGE_SERVICE" = on ] && [ "$DX_USAGE_SERVICE_HOST_PORT" = "$DX_SSH_PORT" ]; then
    echo "Error: DX_USAGE_SERVICE_HOST_PORT ($DX_USAGE_SERVICE_HOST_PORT) must differ from DX_SSH_PORT ($DX_SSH_PORT); both are published by the same container." >&2
    exit 1
fi
dx_require_container_cli

if container_exists "$DX_CONTAINER_NAME"; then
    # Astra F3 / DQ6: an existing same-named container used to make this
    # return success unconditionally, without ever checking whether it was
    # actually this profile's own -- a foreign or unlabelled container
    # would be silently treated as "already provisioned." container_owned
    # prints its own detailed refusal (docker-ssh: a DQ6 label mismatch;
    # apple: never fails, since Apple has no per-object labels at all).
    container_owned "$DX_CONTAINER_NAME" create || exit 1
    echo "Container $DX_CONTAINER_NAME already exists; skipping create."
    exit 0
fi

# Astra F4 item 6: the lifecycle lock's own container (docker-ssh) needs
# $DX_IMAGE to already exist -- `docker create` requires an existing base
# image even for a container that is never started. Checking that FIRST,
# before ever attempting the lock, means a plain first run (no image yet)
# still gets today's exact "run dx-create-image first" message instead of
# a confusing lock-acquisition failure.
if ! container_image_exists "$DX_IMAGE"; then
    echo "Error: Image $DX_IMAGE does not exist. Run ./bin/dx-create-image first (or ./bin/dx, which builds it if missing)." >&2
    exit 1
fi

dx_lifecycle_lock_acquire || exit 1
trap release_pending_claim EXIT HUP INT TERM

dx_nix_volume_claim_acquire "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME"
claim_pending=true

echo "Creating container $DX_CONTAINER_NAME from image $DX_IMAGE..."

BOOTSTRAP_LAUNCH_CMD="$(dx_bootstrap_launch_command)"

# Extract host timezone from macOS
HOST_TZ="$(dx_get_host_timezone)"
if [ -z "$HOST_TZ" ]; then
    echo "Warning: host timezone detection returned empty; defaulting guest timezone to UTC." >&2
    HOST_TZ="UTC"
fi

# The runtime's own stable identity for $DX_IMAGE (qnap-dxe-plan.md DQ4,
# docs/refactor/direct-volume-storage.md section 5): forwarded to the guest
# below so a direct-volume guest can detect a plain image bump on a reused
# volume without needing to reach the image's own store, which a non-empty
# Docker named volume hides. Forwarded for DX_RUNTIME=apple too, even
# though apple-image mode never reads it, so this script's behavior does
# not itself branch on the runtime. Fails closed: a create with no image
# identity is refused rather than proceeding without one.
DX_IMAGE_IDENTITY="$(dx_runtime_image_identity "$DX_IMAGE")" || {
    echo "Error: could not determine the runtime image identity for $DX_IMAGE." >&2
    exit 1
}

# Branch 11 / Phase 4 (qnap-dxe-plan.md DQ7, docs/refactor/
# arch-neutral-guest.md section 4): DX_GUEST_SYSTEM (already a validated
# host config field, default aarch64-linux) is forwarded to the guest so
# its own scripts/lib/dx-guest-system.sh can cross-check it against
# uname -m and refuse on disagreement. Forwarded for DX_RUNTIME=apple too --
# Apple's guest is always aarch64-linux, so this is a no-op confirmation,
# not a behavior change.

# Runtime-neutral parameters (qnap-dxe-plan.md DQ2: "runtime-specific CLI
# syntax ... lives only in the adapter"). Neither this script nor
# dx_runtime_container_create's own dispatch names a single Apple or
# Docker CLI flag; bin/lib/dx-runtime-apple.sh and
# bin/lib/dx-runtime-docker.sh each render their own real create argv from
# this vocabulary -- see bin/lib/dx-runtime.sh's own module comment for the
# complete parameter list and what each adapter does with it (in
# particular: the Nix volume's per-runtime mount target, and docker-ssh's
# restart-policy/DQ6-label handling that Apple has no equivalent of).
#
# Volume roles: nix -> the Nix store volume (each adapter decides its own
# mount target: Apple stages it for the guest to reformat at boot; the
# Docker adapter mounts it directly at /nix, per qnap-dxe-plan.md DQ4).
# persist -> the fixed guest path /persist. bootstrap -> DX_BOOTSTRAP_PATH.

# Branch 11 / Phase 6 (qnap-dxe-plan.md Phase 6 item 4; the one neutral
# create-time health flag pre-authorised for this phase): SSH-independent
# by construction -- reachable through the same docker exec/container exec
# plane Container Station's own health display already uses, never the
# guest's tailnet path, so a transient network issue never reports the
# guest unhealthy. Validates the full lease identity plus a bootstrap
# completion marker (readiness, not mere generation ownership -- Astra F7)
# via bin/lib/dx-ssh-common.sh's dx_bootstrap_health_command, a single fixed
# program with no configuration interpolated into it (D6, Astra F8):
# $DX_BOOTSTRAP_PATH crosses as container-environment DATA below (--env),
# read by the probe itself as "$DX_BOOTSTRAP_PATH", never as text spliced
# into the generated program.
DX_HEALTHCHECK_CMD="$(dx_bootstrap_health_command)"

CREATE_ARGS=(
    --name "$DX_CONTAINER_NAME"
    --image "$DX_IMAGE"
    --volume "nix:$DX_NIX_VOLUME:rw"
    --volume "persist:$DX_PERSIST_VOLUME:/persist:rw"
    --volume "bootstrap:$DX_BOOTSTRAP_VOLUME:$DX_BOOTSTRAP_PATH:rw"
    --env "HOST_TZ=$HOST_TZ"
    --env "DX_GUEST_ACTIVATION_TIMEOUT=$DX_GUEST_ACTIVATION_TIMEOUT"
    --env "DX_GUEST_ACTIVATION_ATTEMPTS=$DX_GUEST_ACTIVATION_ATTEMPTS"
    --env "DX_GUEST_ACTIVATION_RETRY_DELAY=$DX_GUEST_ACTIVATION_RETRY_DELAY"
    --env "DX_NIX_DISK_SIZE=$DX_NIX_DISK_SIZE"
    --env "DX_NIX_STORAGE_MODE=$DX_NIX_STORAGE_MODE"
    --env "DX_IMAGE_IDENTITY=$DX_IMAGE_IDENTITY"
    --env "DX_GUEST_SYSTEM=$DX_GUEST_SYSTEM"
    --env "DX_BOOTSTRAP_PATH=$DX_BOOTSTRAP_PATH"
    --memory "$DX_CONTAINER_MEMORY"
    --cpus "$DX_CONTAINER_CPUS"
    # No bind address: each adapter prepends its own guest SSH address
    # (Branch 11 / Phase 5, qnap-dxe-plan.md DQ5; docs/refactor/
    # remote-aware-ssh.md section 2) -- Apple a fixed 127.0.0.1 literal
    # (byte-identical rendered argv), docker-ssh the NAS's discovered
    # Tailscale address, never the LAN or 0.0.0.0.
    --publish "$DX_SSH_PORT:2222"
    --restart-policy "$DX_CONTAINER_RESTART_POLICY"
    --health-cmd "$DX_HEALTHCHECK_CMD"
    --health-interval 10s
    --health-retries 3
)

# Usage service (DX_USAGE_SERVICE=on only): a second publication through the
# SAME neutral vocabulary as SSH above -- no bind address; each adapter
# prepends its own (Apple loopback, docker-ssh the discovered Tailscale
# address) -- plus the env token the guest reads. Off adds nothing, so the
# rendered create argv is byte-identical to before.
if [ "$DX_USAGE_SERVICE" = on ]; then
    CREATE_ARGS+=(--publish "$DX_USAGE_SERVICE_HOST_PORT:8787" --env "DX_USAGE_SERVICE=on")
fi

if [ -n "$DX_GIT_MOUNT_SOURCE" ]; then
    if [ "$DX_CONTAINER_NAME" = "dx-host" ]; then
        echo "Error: refusing to bind-mount host source into reserved container dx-host." >&2
        exit 1
    fi
    if [ ! -d "$DX_GIT_MOUNT_SOURCE" ]; then
        echo "Error: DX_GIT_MOUNT_SOURCE is not a directory: $DX_GIT_MOUNT_SOURCE" >&2
        exit 1
    fi
    CREATE_ARGS+=(--volume "git:$DX_GIT_MOUNT_SOURCE:$DX_GIT_MOUNT_TARGET:rw")
fi

if [ -f "$DX_SSH_KEY_PUB" ]; then
    DX_PUB_KEY=$(cat "$DX_SSH_KEY_PUB")
    CREATE_ARGS+=(--env "DX_PUB_KEY=$DX_PUB_KEY")
else
    echo "Warning: $DX_SSH_KEY_PUB not found. SSH access may not be configured."
fi

CREATE_ARGS+=(--entrypoint-cmd "$BOOTSTRAP_LAUNCH_CMD" --entrypoint-arg "$DX_BOOTSTRAP_PATH")

dx_runtime_container_create "${CREATE_ARGS[@]}"
claim_pending=false
trap - EXIT HUP INT TERM
dx_lifecycle_lock_release
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then create_container_main "$@"; fi
