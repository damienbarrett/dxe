#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME already exists; skipping create."
    exit 0
fi

if ! container_image_exists "$DX_IMAGE"; then
    echo "Error: Image $DX_IMAGE does not exist. Run ./bin/dx-create-image first (or ./bin/dx, which builds it if missing)." >&2
    exit 1
fi

echo "Creating container $DX_CONTAINER_NAME from image $DX_IMAGE..."

BOOTSTRAP_LAUNCH_CMD="$(dx_bootstrap_launch_command)"

# Volume mounts: DX_NIX_VOLUME -> /var/lib/dx-nix-raw (the bootstrap formats
# and remounts this at /nix); dx-workspace -> /workspace; dx-bootstrap ->
# /guest-bootstrap.
CREATE_FLAGS=(
    --name "$DX_CONTAINER_NAME"
    --entrypoint sh
    --volume "$DX_NIX_VOLUME:/var/lib/dx-nix-raw:rw"
    --volume "$DX_WORKSPACE_VOLUME:$DX_WORKSPACE_PATH:rw"
    --volume "$DX_BOOTSTRAP_VOLUME:$DX_BOOTSTRAP_PATH:rw"
    -m 4G -c 4
    -p "127.0.0.1:$DX_SSH_PORT:2222"
)

if [ -f "$DX_SSH_KEY_PUB" ]; then
    DX_PUB_KEY=$(cat "$DX_SSH_KEY_PUB")
    container create "${CREATE_FLAGS[@]}" -e "DX_PUB_KEY=$DX_PUB_KEY" "$DX_IMAGE" -c "$BOOTSTRAP_LAUNCH_CMD"
else
    echo "Warning: $DX_SSH_KEY_PUB not found. SSH access may not be configured."
    container create "${CREATE_FLAGS[@]}" "$DX_IMAGE" -c "$BOOTSTRAP_LAUNCH_CMD"
fi
