#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if ! container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME does not exist. Nothing to destroy."
    exit 0
fi

if container_is_running "$DX_CONTAINER_NAME"; then
    if ! container_stop_bounded "$DX_CONTAINER_NAME"; then
        echo "Container $DX_CONTAINER_NAME did not stop. Force deleting it..."
        run_with_timeout "$DX_DELETE_COMMAND_TIMEOUT" container delete --force "$DX_CONTAINER_NAME"
        echo "Container force deleted. Persistent volumes and images remain intact."
        exit 0
    fi
fi

echo "Removing DX container: $DX_CONTAINER_NAME..."
run_with_timeout "$DX_DELETE_COMMAND_TIMEOUT" container delete "$DX_CONTAINER_NAME"

echo "Container destroyed. Persistent volumes and images remain intact."
