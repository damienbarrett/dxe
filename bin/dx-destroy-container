#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

destroy_container_main() {
dx_require_container_cli

if ! container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME does not exist; nothing to destroy."
    exit 0
fi

# Astra F4 / WP6.5: acquired before the first mutating call (stop/kill/
# delete below); released on any exit.
dx_lifecycle_lock_acquire || exit 1
trap dx_lifecycle_lock_release EXIT HUP INT TERM

if container_is_running "$DX_CONTAINER_NAME"; then
    if ! container_stop_bounded "$DX_CONTAINER_NAME"; then
        echo "Container $DX_CONTAINER_NAME did not stop cleanly; force-deleting..." >&2
        run_with_timeout "$DX_DELETE_COMMAND_TIMEOUT" dx_runtime_container_delete --force "$DX_CONTAINER_NAME"
        dx_nix_volume_claim_release "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME"
        exit 0
    fi
fi

echo "Removing container $DX_CONTAINER_NAME..."
run_with_timeout "$DX_DELETE_COMMAND_TIMEOUT" dx_runtime_container_delete "$DX_CONTAINER_NAME"
dx_nix_volume_claim_release "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then destroy_container_main "$@"; fi
