#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

destroy_volumes_main() {
dx_require_container_cli

force=0
for arg in "$@"; do
    case "$arg" in
        --force|-f) force=1 ;;
        *)
            echo "Error: Unknown argument: $arg (only --force / -f is accepted)" >&2
            exit 2
            ;;
    esac
done

dx_destroy_volume_lists

# Filter to volumes that actually exist so we don't prompt about nothing.
existing=()
for vol in "${DX_DESTROY_VOLUMES[@]}"; do
    if dx_runtime_volume_exists "$vol"; then
        existing+=("$vol")
    fi
done

if [ "${#existing[@]}" -eq 0 ]; then
    echo "No DX volumes exist; nothing to destroy."
    dx_persist_kept_report
    exit 0
fi

# Branch 11 / Phase 6 (qnap-dxe-plan.md Phase 6 item 7): the whole-operation
# ownership proof, printed and verified before any prompt or deletion --
# refuses the WHOLE destroy (no volume touched) if any one EXISTING volume
# fails its DQ6 label check, rather than a resource-by-resource partial
# destroy. A no-op under DX_RUNTIME=apple (Apple has no DQ6 labels at all),
# so Apple's behaviour below is unaffected, byte for byte.
dx_destroy_plan_and_verify || {
    echo "Error: refusing to destroy any volume: the plan above found a resource that does not belong to this profile (qnap-dxe-plan.md DQ6)." >&2
    exit 1
}

if [ "$force" -ne 1 ]; then
    if [ ! -t 0 ]; then
        echo "Error: Refusing to destroy volumes without --force when stdin is not a tty." >&2
        echo "Pass --force to confirm non-interactively, or run from a terminal." >&2
        exit 1
    fi

    echo "About to destroy the following persistent volumes:"
    for vol in "${existing[@]}"; do
        dx_destroy_volume_describe "$vol"
    done
    echo
    printf 'Type "destroy" to confirm: '
    read -r reply
    if [ "$reply" != "destroy" ]; then
        echo "Confirmation not received; aborting." >&2
        exit 1
    fi
fi

for vol in "${existing[@]}"; do
    echo "Removing volume $vol..."
    if ! dx_runtime_volume_delete "$vol"; then
        echo "Error: Failed to remove volume $vol. A container may still reference it; destroy the container first." >&2
        exit 1
    fi
done
dx_persist_kept_report
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then destroy_volumes_main "$@"; fi
