#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

echo "Waiting for guest SSH to become responsive..."
MAX_RETRIES=120
RETRY_COUNT=0

# Use a simple SSH command to check if the guest is actually ready to accept logins
SSH_CHECK_OPTS=(
    "-i" "$DX_SSH_KEY"
    "-p" "$DX_SSH_PORT"
    "-o" "StrictHostKeyChecking=no"
    "-o" "UserKnownHostsFile=/dev/null"
    "-o" "IdentitiesOnly=yes"
    "-o" "ConnectTimeout=2"
    "-o" "BatchMode=yes"
)

while ! ssh "${SSH_CHECK_OPTS[@]}" dx@127.0.0.1 "bash -lc 'true'" 2>/dev/null; do
    if container_exists "$DX_CONTAINER_NAME" && ! container_is_running "$DX_CONTAINER_NAME"; then
        echo "Error: Container $DX_CONTAINER_NAME stopped before SSH became responsive." >&2
        echo "Last 80 container log lines:" >&2
        container logs -n 80 "$DX_CONTAINER_NAME" 2>&1 | sed 's/^/  /' >&2
        exit 1
    fi
    if [ $RETRY_COUNT -ge $MAX_RETRIES ]; then
        echo "Error: Timed out waiting for guest SSH service to become responsive." >&2
        if container_exists "$DX_CONTAINER_NAME"; then
            echo "Last 80 container log lines:" >&2
            container logs -n 80 "$DX_CONTAINER_NAME" 2>&1 | sed 's/^/  /' >&2
        fi
        exit 1
    fi
    RETRY_COUNT=$((RETRY_COUNT + 1))
    # Provide a visual indicator
    printf "."
    sleep 5
done
printf "\nGuest is ready.\n"
