#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

echo "Waiting for guest SSH to become responsive..."
WAIT_TIMEOUT="${DX_SSH_WAIT_TIMEOUT:-$(dx_default_ssh_wait_timeout)}"
POLL_INTERVAL="${DX_SSH_POLL_INTERVAL:-5}"
PROGRESS_INTERVAL="${DX_SSH_PROGRESS_INTERVAL:-30}"

dx_require_positive_integer DX_SSH_WAIT_TIMEOUT "$WAIT_TIMEOUT"
dx_require_positive_integer DX_SSH_POLL_INTERVAL "$POLL_INTERVAL"
dx_require_positive_integer DX_SSH_PROGRESS_INTERVAL "$PROGRESS_INTERVAL"

WAIT_MINUTES=$(( (WAIT_TIMEOUT + 59) / 60 ))
echo "Bootstrap wait limit: ${WAIT_TIMEOUT}s (approximately ${WAIT_MINUTES} minutes). A fresh factory-reset bootstrap can take several minutes."

# Use a simple SSH command to check if the guest is actually ready to accept
# logins. Options come from the shared single source of truth
# (bin/lib/dx-ssh-common.sh's dx_ssh_common_options), no longer a private
# copy of the same literals (Branch 11 / Phase 5, qnap-dxe-plan.md DQ5;
# docs/refactor/remote-aware-ssh.md section 3) -- plus this probe's own
# BatchMode=yes, which the shared options do not set for every caller: a
# polling readiness loop must never hang on a password/passphrase prompt,
# which is specifically this probe's own concern, not every SSH caller's.
SSH_CHECK_OPTS_STREAM="$(dx_ssh_common_options)"
SSH_CHECK_OPTS=() SSH_CHECK_OPT=""
while IFS= read -r SSH_CHECK_OPT; do SSH_CHECK_OPTS+=("$SSH_CHECK_OPT"); done <<<"$SSH_CHECK_OPTS_STREAM"
SSH_CHECK_OPTS+=("-o" "BatchMode=yes")
# Resolved and checked explicitly, not inlined into the probe loop below:
# this script's own "set -e" does not reliably catch a failing command
# substitution used as one argument among several in a larger command, and
# the loop below runs this destination on every iteration regardless.
DX_WAIT_SSH_ENDPOINT="$(dx_ssh_endpoint)"

# The last probe's stderr, so a timeout can say *why* the probe never
# succeeded. Rewritten on every attempt, so it always holds the final failure.
PROBE_STDERR="$(mktemp "${TMPDIR:-/tmp}/dx-wait-ssh-probe.XXXXXX")"
trap 'rm -f "$PROBE_STDERR"' EXIT

# A refused connection means sshd is not listening yet -- the ordinary
# bootstrap case, and what the guest log tail below explains well. A connect or
# banner-exchange timeout is the opposite situation: the TCP connect *was*
# answered, and sshd then failed to finish the banner exchange inside the
# budget. Something is starved, and the guest log is actively misleading here
# because it shows sshd happily accepting other logins. Naming that is the
# point; the log tail alone cannot.
#
# Deliberately stops short of naming the cause. Two faults produce this, with
# opposite remedies -- a host too loaded to schedule the guest, and a guest
# wedged on its own vCPUs while the host is idle -- and this script cannot tell
# them apart from inside a failed probe. Printing the load average hands over
# the one number that discriminates them rather than guessing.
print_probe_diagnosis() {
    grep -q -e 'banner exchange' -e 'Connection timed out' -e 'Timeout, server' "$PROBE_STDERR" 2>/dev/null || return 0
    echo "The guest answered the TCP connect but never finished the SSH banner exchange within ${DX_SSH_CONNECT_TIMEOUT}s."
    echo "sshd is most likely healthy and starved, not dead, so rebuilding is the wrong first move."
    printf 'Host load average now: %s\n' "$(uptime 2>/dev/null | sed 's/.*[Ll]oad average[s]*: *//' || true)"
    echo "If that load is high, the host is the problem; free it up or retry with a larger DX_SSH_CONNECT_TIMEOUT."
    echo "If the host is idle, the guest is wedged on its own vCPUs -- confirm with 'container exec $DX_CONTAINER_NAME true',"
    echo "which bypasses sshd entirely; if that hangs too, restart the container. See docs/troubleshooting.md."
    printf 'Last probe error: %s\n' "$(tail -n 1 "$PROBE_STDERR" 2>/dev/null || true)"
}

print_container_logs() {
    local lines="$1"
    if ! dx_runtime_logs -n "$lines" "$DX_CONTAINER_NAME" 2>&1 | sed 's/^/  /'; then
        echo "  (container logs unavailable)"
    fi
}

# A monotonic wall-clock deadline: SECONDS is a bash builtin that reports
# real elapsed seconds since it was last reset here, so ELAPSED below always
# reflects total time actually spent waiting -- including a slow or hanging
# ssh probe -- rather than only the time we ourselves spent sleeping.
SECONDS=0
NEXT_PROGRESS="$PROGRESS_INTERVAL"
while ! ssh "${SSH_CHECK_OPTS[@]}" "$DX_WAIT_SSH_ENDPOINT" "bash -lc 'true'" 2>"$PROBE_STDERR"; do
    ELAPSED=$SECONDS
    if container_exists "$DX_CONTAINER_NAME" && ! container_is_running "$DX_CONTAINER_NAME"; then
        echo "Error: Container $DX_CONTAINER_NAME stopped before SSH became responsive." >&2
        echo "Last 80 container log lines:" >&2
        print_container_logs 80 >&2
        exit 1
    fi
    if [ "$ELAPSED" -ge "$WAIT_TIMEOUT" ]; then
        echo "Error: Timed out after ${WAIT_TIMEOUT}s waiting for guest SSH service to become responsive." >&2
        print_probe_diagnosis >&2
        if container_exists "$DX_CONTAINER_NAME"; then
            echo "Last 80 container log lines:" >&2
            print_container_logs 80 >&2
        fi
        exit 1
    fi

    if [ "$ELAPSED" -ge "$NEXT_PROGRESS" ]; then
        printf "\nBootstrap still running (%ss elapsed).\n" "$ELAPSED"
        # Branch 11 / Phase 6 (qnap-dxe-plan.md Phase 6 item 5): named,
        # rather than left for the operator to spot inside the raw log tail
        # below. Live evidence (2026-09-28,
        # docs/refactor/qnap-lifecycle.md's appendix): sshd was already
        # listening while this very probe kept failing for minutes under
        # host contention, and the gate script that hit it discarded this
        # output, losing the diagnosis until reproduced separately. Printed
        # on every tick, not only at the final timeout (print_probe_diagnosis
        # below still runs then, for the fuller two-pattern-specific text).
        DX_WAIT_LAST_PHASE="$(dx_runtime_logs "$DX_CONTAINER_NAME" 2>/dev/null | { grep -E 'Bootstrap phase:|Using bootstrap generation|Waiting for bootstrap payload' || true; } | tail -1)"
        [ -z "$DX_WAIT_LAST_PHASE" ] || printf 'Last bootstrap progress: %s\n' "$DX_WAIT_LAST_PHASE"
        DX_WAIT_LAST_PROBE_ERROR="$(tail -n 1 "$PROBE_STDERR" 2>/dev/null)"
        [ -z "$DX_WAIT_LAST_PROBE_ERROR" ] || printf 'Last probe error: %s\n' "$DX_WAIT_LAST_PROBE_ERROR"
        echo "Latest guest logs:"
        print_container_logs 5
        while [ "$NEXT_PROGRESS" -le "$ELAPSED" ]; do
            NEXT_PROGRESS=$((NEXT_PROGRESS + PROGRESS_INTERVAL))
        done
    fi

    printf "."
    SLEEP_INTERVAL="$POLL_INTERVAL"
    if [ "$((ELAPSED + SLEEP_INTERVAL))" -gt "$WAIT_TIMEOUT" ]; then
        SLEEP_INTERVAL=$((WAIT_TIMEOUT - ELAPSED))
    fi
    sleep "$SLEEP_INTERVAL"
done
printf "\nGuest is ready.\n"
