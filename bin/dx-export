#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

EXPORT_FILE="${1:-dx-host-export-$(date +%Y%m%d-%H%M%S).tar}"
echo "Exporting DX container $DX_CONTAINER_NAME to $EXPORT_FILE"

if ! container_exists "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME does not exist."
    exit 1
fi

container export "$DX_CONTAINER_NAME" > "$EXPORT_FILE"
