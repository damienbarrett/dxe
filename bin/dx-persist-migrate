#!/bin/bash
# Forward migration of a guest's /persist volume into its NAS host directory
# (spec R31-R35, section 6). The logic is dx_persist_migrate_main in
# bin/lib/dx-persist-dir.sh; stop the guest, then select it like the sibling
# commands:
#   ./bin/dx-profile <profile> ./bin/dx-persist-migrate
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
# The entry-point contract (tests/test_refactor_contracts.sh) wants <name>_main
# defined in the entry point itself.
persist_migrate_main() { dx_persist_migrate_main "$@"; }
if [ "${BASH_SOURCE[0]}" = "$0" ]; then persist_migrate_main "$@"; fi
