#!/bin/bash
set -euo pipefail

# dx
# Unified entry point for the DX Experience. Every lifecycle script it calls
# is idempotent toward its end state, so this is safe to run from any starting
# state: first run brings up the full environment, later runs reconnect.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Bringing up DX environment..."

"$SCRIPT_DIR/dx-create-keys"
"$SCRIPT_DIR/dx-create-image"
"$SCRIPT_DIR/dx-create-volumes"
"$SCRIPT_DIR/dx-create-container"
"$SCRIPT_DIR/dx-start-container"
"$SCRIPT_DIR/dx-sync-bootstrap"
"$SCRIPT_DIR/dx-wait-ssh"

exec "$SCRIPT_DIR/dx-ssh" "$@"
