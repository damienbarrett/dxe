#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

# §1: Ensure the named volumes exist
echo "Ensuring nix volume exists..."
container_ensure_volume dx-nix
echo "Ensuring workspace volume exists..."
container_ensure_volume "$DX_WORKSPACE_VOLUME"


# Check if container already exists
if container_exists "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME already exists. Skipping create."
    exit 0
fi

echo "Creating DX container: $DX_CONTAINER_NAME from image $DX_IMAGE"

# Common create flags. Volume mounts: dx-nix → /var/lib/dx-nix-raw (the
# bootstrap formats and remounts this at /nix); dx-workspace → /workspace.
CREATE_FLAGS=(
    --name "$DX_CONTAINER_NAME"
    --volume "dx-nix:/var/lib/dx-nix-raw:rw"
    --volume "$DX_WORKSPACE_VOLUME:$DX_WORKSPACE_PATH:rw"
    -m 4G -c 4
    -p "127.0.0.1:$DX_SSH_PORT:2222"
)

# Check if public key exists
if [ -f "$DX_SSH_KEY_PUB" ]; then
    DX_PUB_KEY=$(cat "$DX_SSH_KEY_PUB")
    container create "${CREATE_FLAGS[@]}" -e "DX_PUB_KEY=$DX_PUB_KEY" "$DX_IMAGE"
else
    echo "Warning: $DX_SSH_KEY_PUB not found. SSH access may not be configured."
    container create "${CREATE_FLAGS[@]}" "$DX_IMAGE"
fi
