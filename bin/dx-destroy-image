#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

destroy_image_main() {
dx_require_container_cli

if ! container_image_exists "$DX_IMAGE"; then
    echo "Image $DX_IMAGE does not exist; nothing to destroy."
    exit 0
fi

echo "Removing image $DX_IMAGE..."
dx_runtime_image_delete "$DX_IMAGE" >/dev/null
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then destroy_image_main "$@"; fi
