#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

create_volumes_main() {
dx_require_container_cli

# Host-path mode (plans/do D-9): probe the share and decide before any volume
# is created; a refusal stops here. Volume mode prints and calls nothing.
dx_persist_action="$(dx_persist_create_decision)" || exit 1

# Ensures every persistent volume exists. container_ensure_volume is itself
# idempotent: it inspects the volume and returns early when it is already there.
echo "Ensuring nix volume $DX_NIX_VOLUME..."
container_ensure_volume "$DX_NIX_VOLUME"

legacy_volume="${DX_LEGACY_WORKSPACE_VOLUME:-dx-workspace}"
if [ "$legacy_volume" != "$DX_PERSIST_VOLUME" ] \
    && dx_runtime_volume_exists "$legacy_volume" \
    && ! dx_runtime_volume_exists "$DX_PERSIST_VOLUME"; then
    cat >&2 <<EOF
Error: legacy persistence volume $legacy_volume exists, but $DX_PERSIST_VOLUME does not.
Run bin/dx-migrate-persist before creating the new /persist volume.
Set DX_LEGACY_WORKSPACE_VOLUME=<old> and DX_PERSIST_VOLUME=<new> for custom volume names.
EOF
    exit 1
fi

# The named persist volume in volume mode; in host-path mode the decision
# above, acted on (that volume is never created there).
dx_persist_storage_ensure "$dx_persist_action"
echo "Ensuring bootstrap volume $DX_BOOTSTRAP_VOLUME..."
container_ensure_volume "$DX_BOOTSTRAP_VOLUME"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then create_volumes_main "$@"; fi
