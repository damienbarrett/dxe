#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

migrate_persist_main() {
dx_require_container_cli

# Apple Container's `container run --rm` intermittently reports
#   Error: no runtime client exists: container is stopped
# for a short-lived temporary container: the container's process finishes
# and the runtime tears it down before the CLI's runtime client finishes
# attaching (or the client attaches to a container that has already
# stopped). This is a race in the host CLI itself, not a defect in the work
# we asked the container to do, and every `container run` below is either a
# read or an idempotent copy, so redoing it on this specific failure is
# safe. dx_runtime_run_ephemeral (bin/lib/dx-runtime-apple.sh) retries a
# bounded number of times on exactly this failure; anything other than this
# exact message is returned immediately on the first attempt, and
# exhausting the bound is reported clearly rather than retried forever.
# These two variables are validated here, unconditionally, rather than
# inside the adapter: dx_runtime_run_ephemeral has no other caller today, so
# validating at its one call site keeps the error-reporting order unchanged
# from before this operation moved behind the runtime contract.
DX_MIGRATE_RUN_MAX_ATTEMPTS="${DX_MIGRATE_RUN_MAX_ATTEMPTS:-5}"
dx_require_positive_integer DX_MIGRATE_RUN_MAX_ATTEMPTS "$DX_MIGRATE_RUN_MAX_ATTEMPTS"
DX_MIGRATE_RUN_RETRY_DELAY="${DX_MIGRATE_RUN_RETRY_DELAY:-1}"
case "$DX_MIGRATE_RUN_RETRY_DELAY" in
    ''|*[!0-9]*) echo "Error: DX_MIGRATE_RUN_RETRY_DELAY must be a non-negative integer, got '$DX_MIGRATE_RUN_RETRY_DELAY'." >&2; exit 1 ;;
esac

legacy_volume="${DX_LEGACY_WORKSPACE_VOLUME:-dx-workspace}"
persist_volume="$DX_PERSIST_VOLUME"
sentinel=".dxe-persist-migrated-from"

if [ "$legacy_volume" = "$persist_volume" ]; then
    echo "Error: legacy and persist volumes are both $persist_volume." >&2
    exit 1
fi

if container_is_running "$DX_CONTAINER_NAME"; then
    echo "Error: container $DX_CONTAINER_NAME is running; stop it before migrating persistence data." >&2
    exit 1
fi

if ! dx_runtime_volume_exists "$legacy_volume"; then
    echo "Legacy volume $legacy_volume does not exist; nothing to migrate."
    exit 0
fi

if ! container_image_exists "$DX_IMAGE"; then
    echo "Error: Image $DX_IMAGE does not exist. Run ./bin/dx-create-image first." >&2
    exit 1
fi

container_ensure_volume "$persist_volume"

sentinel_value="$(dx_runtime_run_ephemeral --rm \
    --volume "$persist_volume:/new:rw" \
    --entrypoint sh \
    "$DX_IMAGE" -lc 'cat "/new/$1" 2>/dev/null || true' -- "$sentinel")"
if [ "$sentinel_value" = "$legacy_volume" ]; then
    echo "Persist volume $persist_volume was already migrated from $legacy_volume."
    exit 0
fi

dest_listing="$(dx_runtime_run_ephemeral --rm \
    --volume "$persist_volume:/new:rw" \
    --entrypoint sh \
    "$DX_IMAGE" -lc 'sentinel=$1; for path in /new/* /new/.[!.]* /new/..?*; do [ -e "$path" ] || continue; name=${path##*/}; [ "$name" = "$sentinel" ] && continue; [ "$name" = lost+found ] && continue; printf "%s\n" "$path"; break; done' -- "$sentinel")"
if [ -n "$dest_listing" ]; then
    echo "Error: destination volume $persist_volume is not empty and has no matching migration sentinel." >&2
    echo "Refusing to merge automatically. Inspect it or choose a different DX_PERSIST_VOLUME." >&2
    exit 1
fi

echo "Migrating $legacy_volume to $persist_volume..."
dx_runtime_run_ephemeral --rm \
    --volume "$legacy_volume:/old:ro" \
    --volume "$persist_volume:/new:rw" \
    --entrypoint sh \
    "$DX_IMAGE" -lc 'legacy=$1; sentinel=$2; cp -a /old/. /new/ && printf "%s\n" "$legacy" > "/new/$sentinel"' -- "$legacy_volume" "$sentinel" >/dev/null

echo "Migration complete."
echo "Verify your data through /persist before deleting the legacy volume."
echo "Legacy cleanup command: container volume rm $legacy_volume"
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then migrate_persist_main "$@"; fi
