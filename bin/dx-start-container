#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"
dx_require_container_cli

if ! container_exists "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME does not exist. Run ./bin/dx-create-container first." >&2
    exit 1
fi

dx_nix_volume_claim_acquire "$DX_NIX_VOLUME" "$DX_CONTAINER_NAME"

if container_is_running "$DX_CONTAINER_NAME"; then
    echo "Container $DX_CONTAINER_NAME is already running; skipping start."
else
    echo "Starting container $DX_CONTAINER_NAME..."
    container start "$DX_CONTAINER_NAME"
fi

dx_sync_output="$("$SCRIPT_DIR/dx-sync-bootstrap")"
printf '%s\n' "$dx_sync_output"

# Diagnostic reads about the state the sync just left the guest in. Failures
# here are swallowed on purpose: they feed either a diagnostic (never the
# reason a start fails) or a check that only fires when a real publish just
# happened (see below) -- an unreadable current/lease listing must not be
# mistaken for either.
dx_running_generation=""
dx_published_generation="$(container exec "$DX_CONTAINER_NAME" readlink "$DX_BOOTSTRAP_PATH/current" 2>/dev/null || true)"
dx_published_generation="${dx_published_generation#generations/}"
dx_lease_listing="$(container exec "$DX_CONTAINER_NAME" sh -c 'ls -1 "$1/.locks/leases" 2>/dev/null || true' -- "$DX_BOOTSTRAP_PATH" 2>/dev/null || true)"
[ -z "$dx_lease_listing" ] || dx_running_generation="$(dx_bootstrap_lease_generation "$dx_lease_listing" || true)"

if dx_sync_published_generation="$(dx_bootstrap_sync_published_generation "$dx_sync_output")"; then
    # A real publish just happened for this start, not the unchanged-content
    # skip. Confirm, bounded, that the guest has actually picked it up before
    # declaring the start a success (Q4, D7 option 3): a swallowed warning is
    # no longer good enough for a publish the guest hasn't run yet. Skip the
    # round trip entirely when the pre-existing read above already shows a
    # match -- no added delay on the common path.
    if [ "$dx_running_generation" != "$dx_sync_published_generation" ]; then
        dx_bootstrap_confirm_publication "$DX_CONTAINER_NAME" "$DX_BOOTSTRAP_PATH" "$dx_sync_published_generation" "$DX_BOOTSTRAP_CONFIRM_TIMEOUT" || exit 1
    fi
else
    # Unchanged-content skip: no fresh publish to confirm. Report, as before,
    # when the guest is still running something other than what's published --
    # purely diagnostic, and must never fail the start.
    dx_bootstrap_report_drift "$dx_running_generation" "$dx_published_generation" "$DX_CONTAINER_NAME"
fi

# Temporary old-base guard for the base-image changeover (README.md, "Base Image Changeover"): the official
# base image never provides /bin/bash (regular file or dangling symlink), so
# its presence matches the known flakes-base signature. This is the host-site
# twin of guard_old_base in bootstrap.sh -- it closes the window where a
# bring-up against an already-running container syncs the payload but never
# re-executes bootstrap.sh. TEMPORARY: remove this block, together with
# bootstrap.sh's guard_old_base, once every machine (primary, side
# containers, profiles) has changed over.
state="$(container exec "$DX_CONTAINER_NAME" sh -c \
    'if [ -e /bin/bash ] || [ -L /bin/bash ]; then echo OLD_BASE; else echo OLD_BASE_ABSENT; fi')" \
    || { echo "Error: could not verify the guest base (container exec failed)." >&2; exit 1; }
case "$state" in
    OLD_BASE_ABSENT) : ;;
    OLD_BASE)
        echo "Error: /bin/bash is present in $DX_CONTAINER_NAME, matching the known flakes-base signature (nixpkgs/nix-flakes)." >&2
        echo "This container was built from the old flakes base and must be rebuilt under the official base." >&2
        echo "Follow the Base Image Changeover procedure in docs/release-maintenance.md before retrying." >&2
        exit 1
        ;;
    *)
        echo "Error: unexpected guest base verification output: $state" >&2
        exit 1
        ;;
esac
