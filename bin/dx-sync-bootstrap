#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

sync_bootstrap_main() {
dx_require_container_cli

local result_file="" status=0 generation=""
while [ $# -gt 0 ]; do
    case "$1" in
        --result-file) result_file="$2"; shift 2 ;;
        *) shift ;;
    esac
done

# WP5.1 (Fable A2): the whole publish-or-skip body now lives in
# bin/lib/dx-bootstrap-sync.sh's dx_bootstrap_sync, which puts every one of
# its branches inside the kcov 100% gate (bin/dx* entrypoints are exempt --
# tests/coverage/exclusions.txt). It sets `generation` here via Bash dynamic
# scoping rather than printing it, so its own progress/result prose prints in
# real time as it runs, exactly as before this split.
dx_bootstrap_sync "$DX_CONTAINER_NAME" "$DX_BOOTSTRAP_SOURCE" "$DX_BOOTSTRAP_PATH" || status=$?
case "$status" in
    0) [ -z "$result_file" ] || dx_bootstrap_sync_result_write "$result_file" published "$generation" || exit 1 ;;
    3) [ -z "$result_file" ] || dx_bootstrap_sync_result_write "$result_file" unchanged "$generation" || exit 1 ;;
    *) exit 1 ;;
esac
}
if [ "${BASH_SOURCE[0]}" = "$0" ]; then sync_bootstrap_main "$@"; fi
