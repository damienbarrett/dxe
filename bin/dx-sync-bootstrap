#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/dx-lib.sh"

if ! container_exists "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME does not exist. Run ./bin/dx-create-container first." >&2
    exit 1
fi

for _ in {1..30}; do
    if container_is_running "$DX_CONTAINER_NAME"; then
        break
    fi
    sleep 1
done

if ! container_is_running "$DX_CONTAINER_NAME"; then
    echo "Error: Container $DX_CONTAINER_NAME is not running. Run ./bin/dx-start-container first." >&2
    exit 1
fi

if [ -z "$DX_BOOTSTRAP_PATH" ] || [ "$DX_BOOTSTRAP_PATH" = "/" ]; then
    echo "Error: Unsafe DX_BOOTSTRAP_PATH: $DX_BOOTSTRAP_PATH" >&2
    exit 1
fi

# Self-detect bootstrap state. A freshly-started container needs a moment to
# enter its "waiting for payload" state before the payload can be pushed. An
# already-warm container that has already received a payload will have the
# .dx-bootstrap-ready marker present. Wait up to 30s for either marker before
# proceeding so the script works whether called right after start or against a
# long-running container, with no env-var coordination required.
for _ in {1..30}; do
    if container exec "$DX_CONTAINER_NAME" sh -c \
        'test -f "$1/.dx-bootstrap-waiting" || test -f "$1/.dx-bootstrap-ready"' \
        -- "$DX_BOOTSTRAP_PATH" >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

if [ ! -f "$DX_BOOTSTRAP_SOURCE/bootstrap.sh" ]; then
    echo "Error: Bootstrap source $DX_BOOTSTRAP_SOURCE/bootstrap.sh does not exist." >&2
    exit 1
fi

tar_create_args=()
if tar --no-xattrs -C "$DX_BOOTSTRAP_SOURCE" -cf /dev/null . >/dev/null 2>&1; then
    tar_create_args+=(--no-xattrs)
fi
if tar --no-mac-metadata -C "$DX_BOOTSTRAP_SOURCE" -cf /dev/null . >/dev/null 2>&1; then
    tar_create_args+=(--no-mac-metadata)
fi

echo "Syncing bootstrap payload from $DX_BOOTSTRAP_SOURCE to $DX_CONTAINER_NAME:$DX_BOOTSTRAP_PATH..."

container exec "$DX_CONTAINER_NAME" sh -c '
set -eu
dest="$1"
mkdir -p "$dest"
rm -rf "$dest"/* "$dest"/.[!.]* "$dest"/..?* 2>/dev/null || true
' -- "$DX_BOOTSTRAP_PATH"

COPYFILE_DISABLE=1 tar "${tar_create_args[@]}" -C "$DX_BOOTSTRAP_SOURCE" -cf - . | container exec -i "$DX_CONTAINER_NAME" tar -xf - -C "$DX_BOOTSTRAP_PATH"

container exec "$DX_CONTAINER_NAME" sh -c '
set -eu
dest="$1"
chmod -R a+rX "$dest"
if id -u dx >/dev/null 2>&1; then
    chown -R dx:dx "$dest"
fi
chmod +x "$dest/bootstrap.sh"
touch "$dest/.dx-bootstrap-ready"
' -- "$DX_BOOTSTRAP_PATH"

echo "Bootstrap payload is ready."
