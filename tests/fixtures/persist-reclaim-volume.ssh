<TOOLS>/docker exec -u dx dx-rc bash -c $'PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"\ntemproots=$1\nproc=$2\nif [ ! -d "$proc/1" ]; then\n    echo "cannot see the process table ($proc/1 is not visible); not judging which temporary roots are stale" >&2\n    exit 3\nfi\nremoved=0\nstatus=0\nfor path in "$temproots"/*; do\n    name=${path##*/}\n    case $name in\n        \'\'|*[!0-9]*) continue ;;\n    esac\n    if [ -L "$path" ] || [ ! -f "$path" ] || [ -e "$proc/$name" ]; then\n        continue\n    fi\n    if rm -f -- "$path"; then\n        removed=$((removed + 1))\n    else\n        status=1\n    fi\ndone\nprintf \'%s\\n\' "$removed"\nexit "$status"\n' bash /nix/var/nix/temproots /proc
