DXE_DOCKER_BIN=""
if command -v docker >/dev/null 2>&1; then DXE_DOCKER_BIN="$(command -v docker)"; else for dxe_cand in /share/*/.qpkg/container-station/bin/docker; do if [ -x "$dxe_cand" ]; then DXE_DOCKER_BIN="$dxe_cand"; break; fi; done; fi
echo "${DXE_DOCKER_BIN:-NOTFOUND}"
