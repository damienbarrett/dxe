<TOOLS>/docker exec -u root dx-rc bash -c $'PATH="${PATH:+$PATH:}/nix/var/nix/profiles/per-user/root/profile/bin:/nix/var/nix/profiles/default/bin"\nstore=$1\nlog=$2\nif [ -L "$store" ] || [ ! -d "$store" ]; then\n    printf \'0\\n\'\n    exit 0\nfi\nfor tool in stat find chown; do\n    if ! command -v "$tool" >/dev/null; then\n        echo "$tool not found; not handing root-owned Nix paths back" >&2\n        exit 127\n    fi\ndone\nowner=$(stat -c \'%u:%g\' -- "$store") || exit 1\nif [ "${owner%%:*}" = 0 ]; then\n    printf \'0\\n\'\n    exit 0\nfi\nhanded=0\nstatus=0\nwhile IFS= read -r -d \'\' path; do\n    if chown -R -P -- "$owner" "$path"; then\n        handed=$((handed + 1))\n    else\n        status=1\n    fi\ndone < <(find "$store" -mindepth 1 -maxdepth 1 -uid 0 -print0)\nif [ -d "$log" ] && [ ! -L "$log" ]; then\n    while IFS= read -r -d \'\' path; do\n        if chown -h -- "$owner" "$path"; then\n            handed=$((handed + 1))\n        else\n            status=1\n        fi\n    done < <(find "$log" -mindepth 1 -uid 0 -print0)\nfi\nprintf \'%s\\n\' "$handed"\nexit "$status"\n' bash /nix/store /nix/var/log/nix
