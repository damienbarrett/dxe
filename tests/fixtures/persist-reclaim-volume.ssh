<TOOLS>/docker exec dx-rc /usr/bin/bash -lc $'\n        export PATH="/nix/var/nix/profiles/per-user/root/profile/bin:$PATH"\n        store_path="$1/store"\n        store_usage="$(du -sh "$store_path" 2>/dev/null)" || exit $?\n        store_size="${store_usage%%\t*}"\n        [ "$store_size" = "$store_usage" ] && store_size="${store_usage%% *}"\n        printf "  %-14s %s\\n" "$store_path" "$store_size"\n        df_output="$(df -h "$@")" || exit $?\n        while IFS= read -r line; do\n            printf "  %s\\n" "$line"\n        done <<EOF\n$df_output\nEOF\n    ' bash /nix /persist
