# qnap-persist-canary-example.env
#
# The shape of the DISPOSABLE QNAP guest that the /persist host-access live
# suite (tests/test_persist_host_dir_live.sh, plans/do WP7.1) runs on: a guest
# whose /persist is a directory on a NAS share (DX_PERSIST_STORAGE=host-path)
# instead of a named volume. Placeholder values only -- no real hostname,
# account, share path, storage-pool path or key material (this repository is
# public; see tests/test_section1_secrets.sh). "qnap-dxe" is the repository's
# established example ssh_config alias (tests/qnap/lib/phase0-common.sh's own
# default), not a secret.
#
# The live suite DESTROYS and RESETS this guest on purpose (dx-destroy,
# dx-destroy-volumes --force, dx-factory-reset --force), so every name below
# that those commands act on is namespaced with "canary" and the suite refuses
# to run unless it is: the container (^dx-[a-z0-9-]*canary[a-z0-9-]*$, never
# dx-qnap, dx-host or dx-test), all three volumes, the image (dx-destroy-image
# deletes it by name: images carry no ownership labels) and the SSH key pair
# (dx-destroy-keys deletes it). Never reuse the production guest's image name
# or key pair here.
#
# Copy this file to ${XDG_CONFIG_HOME:-$HOME/.config}/dxe/profiles/ under its
# own name (./bin/dx-profile <name> looks up <name>.env literally), then:
#   - set DX_REMOTE_HOST to your own ssh_config alias for the NAS;
#   - set DX_PERSIST_HOST_ROOT to your <qnap-share> root (the share the
#     tooling creates dxe/<guest>/persist under; an absolute path, no ':');
#   - create the mount sentinel: a regular file directly under that share
#     root that exists only while the share is mounted and unlocked, and name
#     it in DX_PERSIST_HOST_MOUNT_SENTINEL (a plain file name: no '/', not
#     starting with '.' or '-'). Creating a new guest directory needs it;
#   - replace /absolute/path/to with your own home directory in the key
#     paths (profiles never expand a bare ~ or $HOME);
#   - pick an SSH port no other guest on the NAS publishes.
#
# Usage (once the private copy exists, e.g. as qnap-persist-canary.env):
#   DXE_PERSIST_LIVE_CANARY=dx-qnap-persist-canary \
#     ./bin/dx-profile qnap-persist-canary tests/run.sh --live \
#     --file tests/test_persist_host_dir_live.sh
#
# DX_GUEST_SYSTEM must match the NAS's own `uname -m` (aarch64 ->
# aarch64-linux, x86_64 -> x86_64-linux); the docker-ssh adapter's preflight
# refuses a mismatch (DQ7).
export DX_RUNTIME=docker-ssh
export DX_REMOTE_HOST=qnap-dxe
export DX_GUEST_SYSTEM=x86_64-linux
export DX_NIX_STORAGE_MODE=direct-volume

# Smaller than the production guest's 8 GB / 4 CPU in both memory and CPUs,
# so a full bootstrap on the NAS competes less with it: 6 GB / 2 CPU.
export DX_CONTAINER_MEMORY=6G
export DX_CONTAINER_CPUS=2

# "no", and the live suite requires it: one case starts the container
# straight through the runtime (as a restart policy would) after hiding the
# directory marker, and expects the guest to stop itself and STAY stopped.
export DX_CONTAINER_RESTART_POLICY=no

# Every name the destroy and reset commands act on contains "canary".
export DX_CONTAINER_NAME=dx-qnap-persist-canary
export DX_IMAGE=dx-qnap-persist-canary-nixos
export DX_NIX_VOLUME=dx-qnap-persist-canary-nix
export DX_PERSIST_VOLUME=dx-qnap-persist-canary-persist
export DX_BOOTSTRAP_VOLUME=dx-qnap-persist-canary-bootstrap

# A canary-only key pair (dx-factory-reset deletes it; dx-create-keys makes a
# new one on the next bring-up).
export DX_SSH_KEY=/absolute/path/to/.ssh/dxe/dx-qnap-persist-canary_key
export DX_SSH_KEY_PUB=/absolute/path/to/.ssh/dxe/dx-qnap-persist-canary_key.pub

# Any port no other guest on the NAS publishes (the production guest uses the
# registry default, 2222, which the live suite refuses). Published on the
# NAS's discovered Tailscale address only (DQ5).
export DX_SSH_PORT=2224

# /persist on the NAS share: <DX_PERSIST_HOST_ROOT>/dxe/<DX_CONTAINER_NAME>/persist,
# created by the tooling for a genuinely new guest only (plans/do D-1, R15).
export DX_PERSIST_STORAGE=host-path
export DX_PERSIST_HOST_ROOT=/absolute/path/to/qnap-share
export DX_PERSIST_HOST_MOUNT_SENTINEL=dxe-share-mounted

# The canary never enables the usage service (DX_USAGE_SERVICE stays off):
# its host port would collide with the production guest's.

# Optional: pin this profile to the one checkout allowed to run it, so a
# second checkout cannot drive the NAS. Uncomment and set your own absolute
# path (kept only in your private profile, never in a tracked file);
# bin/dx-profile refuses with status 2 from any other checkout. See
# DX_PROFILE_ROOT in docs/configuration.md.
# export DX_PROFILE_ROOT=/absolute/path/to/checkout
