# qnap-example.env
#
# Documents the config shape for the remote Docker-over-SSH runtime
# (qnap-dxe-plan.md Phase 2, DQ1/DQ3). Placeholder values only -- no real
# hostname, username, storage-pool path, or key material (this repository is
# public; see docs/refactor/constraints.md and tests/test_section1_secrets.sh).
# "qnap-dxe" is the repository's established example/ssh_config alias name,
# not a secret (tests/qnap/lib/phase0-common.sh's own default).
#
# The real, working profile that selects an actual NAS is a LOCAL file this
# example does not replace: copy this file, rename it (its filename is never
# read as a name -- ./bin/dx-profile <name> looks up tests/profiles/<name>.env
# literally), and set DX_REMOTE_HOST to your own ssh_config alias. Do not
# commit that copy: tests/profiles/ has no repository-wide ignore rule for
# *.env, so add your own profile's exact filename to .gitignore before first
# use, the same way dx_key/dx_key.pub are ignored by name rather than by a
# wildcard.
#
# Usage (once a real profile exists, e.g. tests/profiles/qnap.env):
#   ./bin/dx-profile qnap ./bin/dx-status
#
# DX_REMOTE_HOST must name a Host alias already configured in ~/.ssh/config
# (or the system ssh_config) that owns the username, identity file, MagicDNS
# name/address, and host-key policy for that NAS (DQ1) -- this profile only
# ever stores the alias name, never ssh option text. Before first use,
# confirm the alias connects non-interactively:
#   ssh -o BatchMode=yes -o ConnectTimeout=10 <your-alias> true
#
# DX_GUEST_SYSTEM must match the NAS's own `uname -m` (aarch64 ->
# aarch64-linux, x86_64 -> x86_64-linux); the docker-ssh adapter's preflight
# refuses to proceed on a mismatch rather than silently building or running
# the wrong architecture (DQ7).
export DX_RUNTIME=docker-ssh
export DX_REMOTE_HOST=qnap-dxe
export DX_GUEST_SYSTEM=x86_64-linux
export DX_NIX_STORAGE_MODE=direct-volume

# QNAP guest sizing (Phase 4 user decision, 2026-09-27): 8 GB / 4 CPU,
# smaller than Apple's 12G default -- see
# docs/refactor/arch-neutral-guest.md.
export DX_CONTAINER_MEMORY=8G
export DX_CONTAINER_CPUS=4

# Left at DQ3's cautious initial default ("no") until reboot/restart
# behavior has passed its own live gate on the real NAS; the coordinating
# session raises this to "unless-stopped" in the real (ignored) profile once
# that gate passes, not here.
export DX_CONTAINER_RESTART_POLICY=no

# Namespaced distinctly from both the Apple default (dx-host/dx-nixos-26.05)
# and the Apple test profile (dx-test/dx-test-nixos) so a mistake can never
# make a docker-ssh command target an Apple-runtime name or vice versa --
# same reasoning as dx-test.env's own comment on why its names differ from
# the defaults.
export DX_CONTAINER_NAME=dx-qnap
export DX_IMAGE=dx-qnap-nixos
export DX_NIX_VOLUME=dx-qnap-nix
export DX_PERSIST_VOLUME=dx-qnap-persist
export DX_BOOTSTRAP_VOLUME=dx-qnap-bootstrap

# A separate key pair, never the Apple dx_key/dx-test_key pair (dx-create-keys
# generates whichever pair a profile's DX_SSH_KEY/DX_SSH_KEY_PUB name).
export DX_SSH_KEY=${DX_PROJECT_ROOT}/dx-qnap_key
export DX_SSH_KEY_PUB=${DX_PROJECT_ROOT}/dx-qnap_key.pub
