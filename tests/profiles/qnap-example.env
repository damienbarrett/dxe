# qnap-example.env
#
# Documents the config shape for the remote Docker-over-SSH runtime
# (qnap-dxe-plan.md Phase 2, DQ1/DQ3). Placeholder values only -- no real
# hostname, username, storage-pool path, or key material (this repository is
# public; see docs/refactor/constraints.md and tests/test_section1_secrets.sh).
# "qnap-dxe" is the repository's established example/ssh_config alias name,
# not a secret (tests/qnap/lib/phase0-common.sh's own default).
#
# The real, working profile that selects an actual NAS is a LOCAL file this
# example does not replace: copy this file, rename it (its filename is never
# read as a name -- ./bin/dx-profile <name> looks up <name>.env literally).
# Store the copy in ${XDG_CONFIG_HOME:-$HOME/.config}/dxe/profiles/, and set
# DX_REMOTE_HOST to your own ssh_config alias. Replace the example's key
# paths with absolute paths under ~/.ssh/dxe/ (no ~ or $HOME expansion in
# profiles). Personal profiles and key material belong outside the checkout.
#
# See docs/qnap-runbook.md for the full install/preflight/operate/update/
# backup/restore/removal walkthrough this profile shape is built for
# (Branch 11 / Phase 6, qnap-dxe-plan.md Phase 6 item 1).
#
# Usage (once a real user profile exists, e.g. ~/.config/dxe/profiles/qnap.env):
#   ./bin/dx-profile qnap ./bin/dx-status
#
# DX_REMOTE_HOST must name a Host alias already configured in ~/.ssh/config
# (or the system ssh_config) that owns the username, identity file, MagicDNS
# name/address, and host-key policy for that NAS (DQ1) -- this profile only
# ever stores the alias name, never ssh option text. Before first use,
# confirm the alias connects non-interactively:
#   ssh -o BatchMode=yes -o ConnectTimeout=10 <your-alias> true
#
# DX_GUEST_SYSTEM must match the NAS's own `uname -m` (aarch64 ->
# aarch64-linux, x86_64 -> x86_64-linux); the docker-ssh adapter's preflight
# refuses to proceed on a mismatch rather than silently building or running
# the wrong architecture (DQ7).
export DX_RUNTIME=docker-ssh
export DX_REMOTE_HOST=qnap-dxe
export DX_GUEST_SYSTEM=x86_64-linux
export DX_NIX_STORAGE_MODE=direct-volume

# QNAP guest sizing (Phase 4 user decision, 2026-09-27): 8 GB / 4 CPU,
# smaller than Apple's 12G default -- see
# docs/refactor/arch-neutral-guest.md.
export DX_CONTAINER_MEMORY=8G
export DX_CONTAINER_CPUS=4

# Left at DQ3's cautious initial default ("no") deliberately: this is the
# checked-in EXAMPLE, not a real profile. The reboot/restart behavior HAS
# passed its own live gate on the production NAS (2026-09-28: a container
# restart, a Container Station restart, and a full NAS reboot all left a
# disposable guest's state, generation, and Tailscale-only bind intact --
# see docs/qnap-runbook.md and qnap-dxe-plan.md's Phase 6 status), but that
# proof is per-NAS, not something this checked-in example can inherit for
# every reader's own NAS. Set DX_CONTAINER_RESTART_POLICY=unless-stopped in
# your own (real, ignored) profile only after running the same check
# yourself, per the runbook's guardrail (at least one full bootstrap
# already completed, dx-status showing a healthy generation).
export DX_CONTAINER_RESTART_POLICY=no

# Namespaced distinctly from both the Apple default (dx-host/dx-nixos-26.05)
# and the Apple test profile (dx-test/dx-test-nixos) so a mistake can never
# make a docker-ssh command target an Apple-runtime name or vice versa --
# same reasoning as dx-test.env's own comment on why its names differ from
# the defaults.
export DX_CONTAINER_NAME=dx-qnap
export DX_IMAGE=dx-qnap-nixos
export DX_NIX_VOLUME=dx-qnap-nix
export DX_PERSIST_VOLUME=dx-qnap-persist
export DX_BOOTSTRAP_VOLUME=dx-qnap-bootstrap

# A separate key pair, never the Apple dx_key/dx-test_key pair (dx-create-keys
# generates whichever pair a profile's DX_SSH_KEY/DX_SSH_KEY_PUB name).
export DX_SSH_KEY=${DX_PROJECT_ROOT}/dx-qnap_key
export DX_SSH_KEY_PUB=${DX_PROJECT_ROOT}/dx-qnap_key.pub

# This is the ONE port DXE ever publishes for a docker-ssh guest, and it
# is published on the NAS's own discovered Tailscale address, never
# loopback, the LAN, or 0.0.0.0 (qnap-dxe-plan.md DQ5) -- that address is
# discovered at run time and never written to any tracked file, this one
# included.
#
# 2223, not the bin/lib/dx-config.sh default (2222): this file documents
# the PRODUCTION QNAP profile's own shape (qnap-dxe-plan.md Phase 7 item
# 6, docs/qnap-runbook.md section 9.5), and 2223 is the DECIDED
# production port for the cutover period (user decision, 2026-09-28) --
# distinct from the canary's own port 2222
# (tests/profiles/qnap-canary-example.env) so the two can run
# concurrently while the canary is still live. This is explicitly
# TEMPORARY: once the canary is retired and its port is free again, the
# production profile may move back to 2222 -- a later, separate,
# explicit decision, not automatic and not assumed here.
export DX_SSH_PORT=2223
