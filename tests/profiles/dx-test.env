# dx-test.env
#
# Fully isolated DX environment for validating lifecycle scripts end-to-end
# without touching the primary dx-host instance. Every name is namespaced so
# the test container, image, volumes, and SSH key live alongside the primary
# resources without contention.
#
# Usage:
#   source tests/profiles/dx-test.env && ./bin/dx
# or:
#   ./bin/dx-profile dx-test ./bin/dx
#
# Both containers can run simultaneously because DX_SSH_PORT differs.

export DX_CONTAINER_NAME=dx-test
export DX_IMAGE=dx-test-nixos
export DX_SSH_PORT=2299
export DX_NIX_VOLUME=dx-test-nix
export DX_WORKSPACE_VOLUME=dx-test-workspace
export DX_BOOTSTRAP_VOLUME=dx-test-bootstrap
export DX_SSH_KEY="$DX_PROJECT_ROOT/dx-test_key"
export DX_SSH_KEY_PUB="$DX_PROJECT_ROOT/dx-test_key.pub"
