# qnap-canary-example.env
#
# Documents the config shape for the canary profile used to promote the
# QNAP runtime from proof-of-concept to daily use (qnap-dxe-plan.md
# Phase 7, docs/refactor/qnap-promotion.md, docs/qnap-runbook.md section
# "9. Promotion (canary acceptance)"). Placeholder values only -- no real
# hostname, username, storage-pool path, or key material (this repository
# is public; see docs/refactor/constraints.md and
# tests/test_section1_secrets.sh). "qnap-dxe" is the repository's
# established example/ssh_config alias name, not a secret
# (tests/qnap/lib/phase0-common.sh's own default).
#
# This is a SIBLING of tests/profiles/qnap-example.env, not a replacement
# for it: qnap-example.env documents the general docker-ssh profile shape
# (and, unchanged, the proposed PRODUCTION identifiers); this file
# documents the CANARY's own settled shape -- a distinct, real, git-ignored
# profile that runs alongside the general example, never merged into it,
# so an operator following the runbook's promotion section can copy this
# file directly instead of hand-deriving the canary's delta from prose.
#
# The real, working profile that selects an actual NAS is a LOCAL file
# this example does not replace: copy this file, rename it (its filename
# is never read as a name -- ./bin/dx-profile <name> looks up
# tests/profiles/<name>.env literally), and set DX_REMOTE_HOST to your own
# ssh_config alias. Do not commit that copy: tests/profiles/ has no
# repository-wide ignore rule for *.env, so add your own profile's exact
# filename to .gitignore before first use, the same way dx_key/dx_key.pub
# are ignored by name rather than by a wildcard.
#
# See docs/qnap-runbook.md section 9 for the full one-week acceptance
# checklist this profile shape is built for (Branch 11 / Phase 7,
# qnap-dxe-plan.md Phase 7 items 1, 2, 4, 5).
#
# Usage (once a real profile exists, e.g. tests/profiles/qnap-canary.env):
#   ./bin/dx-profile qnap-canary ./bin/dx-status
#
# DX_REMOTE_HOST must name a Host alias already configured in ~/.ssh/config
# (or the system ssh_config) that owns the username, identity file,
# MagicDNS name/address, and host-key policy for that NAS (DQ1) -- this
# profile only ever stores the alias name, never ssh option text. Before
# first use, confirm the alias connects non-interactively:
#   ssh -o BatchMode=yes -o ConnectTimeout=10 <your-alias> true
#
# DX_GUEST_SYSTEM must match the NAS's own `uname -m` (aarch64 ->
# aarch64-linux, x86_64 -> x86_64-linux); the docker-ssh adapter's preflight
# refuses to proceed on a mismatch rather than silently building or running
# the wrong architecture (DQ7).
export DX_RUNTIME=docker-ssh
export DX_REMOTE_HOST=qnap-dxe
export DX_GUEST_SYSTEM=x86_64-linux
export DX_NIX_STORAGE_MODE=direct-volume

# Canary guest sizing -- the USER'S OWN choice for the canary only (Phase 7
# user decision, 2026-09-28): 8 GB / 2 CPU, fewer CPUs than
# qnap-example.env's own documented 8G/4CPU default. This is a per-profile
# choice recorded here for the canary specifically, NOT a new default --
# qnap-example.env keeps its own 4-CPU value and rationale unchanged. See
# docs/refactor/qnap-promotion.md section A1.
export DX_CONTAINER_MEMORY=8G
export DX_CONTAINER_CPUS=2

# unless-stopped FROM CREATION -- the user's own explicit choice for the
# canary (Phase 7 user decision, 2026-09-28), unlike qnap-example.env's
# cautious "no" default. This is deliberate, not an oversight: the
# reboot/restart behaviour already passed its own live gate on this NAS
# during Phase 6's maintenance window (a container restart, a Container
# Station restart, and a full NAS reboot all left a disposable guest's
# state, generation, and Tailscale-only bind intact -- see
# docs/qnap-runbook.md and qnap-dxe-plan.md's Phase 6 status), and the
# canary's own one-week acceptance run is what extends that same proof to
# a guest in real daily use. qnap-example.env's own guardrail (run the
# check yourself before opting in) does not apply here precisely because
# that check has already been run, on this NAS, before this profile's
# own creation.
export DX_CONTAINER_RESTART_POLICY=unless-stopped

# Namespaced distinctly from the Apple default (dx-host/dx-nixos-26.05),
# the Apple test profile (dx-test/dx-test-nixos), AND the general/
# production-shaped qnap-example.env (dx-qnap/dx-qnap-nixos) -- a mistake
# can never make a docker-ssh command target an Apple-runtime name, the
# eventual production QNAP profile, or vice versa. Same reasoning as
# dx-test.env's own comment on why its names differ from the defaults.
export DX_CONTAINER_NAME=dx-qnap-canary
export DX_IMAGE=dx-qnap-canary-nixos
export DX_NIX_VOLUME=dx-qnap-canary-nix
export DX_PERSIST_VOLUME=dx-qnap-canary-persist
export DX_BOOTSTRAP_VOLUME=dx-qnap-canary-bootstrap

# A separate key pair, never the Apple dx_key/dx-test_key pair, and never
# the eventual production profile's own pair either (dx-create-keys
# generates whichever pair a profile's DX_SSH_KEY/DX_SSH_KEY_PUB name).
export DX_SSH_KEY=${DX_PROJECT_ROOT}/dx-qnap-canary_key
export DX_SSH_KEY_PUB=${DX_PROJECT_ROOT}/dx-qnap-canary_key.pub

# Port 2222 (Phase 7 user decision, 2026-09-28) -- the same value
# qnap-example.env itself documents, since the canary was created first
# and there is nothing else yet on this NAS to share a port with. The
# eventual production profile's own proposed port (2223, still a proposal
# until that profile is actually created -- see
# docs/refactor/qnap-promotion.md section C2) is chosen distinct from
# THIS port precisely so the two can run concurrently during the
# promotion window if wanted, never the other way around. Published on
# the NAS's own discovered Tailscale address only, never loopback, the
# LAN, or 0.0.0.0 (qnap-dxe-plan.md DQ5) -- that address is discovered at
# run time and never written to any tracked file, this one included.
export DX_SSH_PORT=2222
