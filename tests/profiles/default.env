# default.env
#
# The DX environment's *implicit* profile. This file is for documentation:
# sourcing it leaves every variable unset, so the fallbacks in bin/dx-lib.sh
# apply exactly as they would on a fresh shell. Use this file as a template
# when authoring a new profile (copy it, rename, and set non-default values
# only for the layers you want to isolate).
#
# Defaults reproduced here as comments for reference. Uncomment and edit in a
# copy of this file when creating a real profile (see dx-test.env).
#
# export DX_CONTAINER_NAME=dx-host
# export DX_IMAGE=dx-nixos-25.11
# export DX_SSH_PORT=2222
# export DX_NIX_VOLUME=dx-nix
# export DX_PERSIST_VOLUME=dx-persist
# export DX_BOOTSTRAP_VOLUME=dx-bootstrap
# export DX_GUEST_ACTIVATION_TIMEOUT=600
# export DX_GUEST_ACTIVATION_ATTEMPTS=2
# export DX_GUEST_ACTIVATION_RETRY_DELAY=5
# export DX_SSH_KEY="$DX_PROJECT_ROOT/dx_key"
# export DX_SSH_KEY_PUB="$DX_PROJECT_ROOT/dx_key.pub"
# export DX_CONTEXT_DIR="$DX_PROJECT_ROOT/container/aarch64-darwin-apple-container-dx-nixos-25.11"
# HOST_TZ is detected from the host automatically; timezone detection falls
# back to UTC if no host IANA timezone can be found.
