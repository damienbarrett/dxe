# dx-tinty.env
#
# Lifecycle profile that runs DX scripts against a side-car container named
# dx-tinty, with every resource (image, volumes, key) namespaced under
# dx-tinty so it can coexist with the primary dx-host instance.
#
# Usage:
#   ./bin/dx-profile dx-tinty ./bin/dx
#   ./bin/dx-profile dx-tinty ./bin/dx-status
#   ./bin/dx-profile dx-tinty ./bin/dx-destroy

export DX_CONTAINER_NAME=dx-tinty
export DX_IMAGE=dx-tinty-nixos
export DX_SSH_PORT=2298
export DX_NIX_VOLUME=dx-tinty-nix
export DX_PERSIST_VOLUME=dx-tinty-persist
export DX_BOOTSTRAP_VOLUME=dx-tinty-bootstrap
export DX_SSH_KEY=${DX_PROJECT_ROOT}/dx-tinty_key
export DX_SSH_KEY_PUB=${DX_PROJECT_ROOT}/dx-tinty_key.pub
